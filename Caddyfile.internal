# TuneX — Docker 内部统一 HTTP 入口（生产可选 Caddy profile）
#
# Host Nginx / 宝塔 / 1Panel (:80/:443, TLS)
#      -> 127.0.0.1:${TUNEX_HTTP_PORT:-13000}
#      -> tunex-caddy:80
#      -> backend/web
#
# 本文件仅在 docker-compose.prod.yaml 启用 --profile caddy 时使用。公网 TLS 由宿主机反代负责。
# standalone 模式改用 Caddyfile.prod。

{
	servers {
		# 生产入口只绑定宿主机 loopback；Docker 转发后的宿主机代理地址属于私网。
		# strict 从右向左解析 XFF，避免信任客户端伪造的左侧地址。
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:80 {
	encode zstd gzip

	# Agent 控制面 Socket.IO / WebSocket。
	handle /socket.io/* {
		reverse_proxy backend:3001 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /healthz {
		reverse_proxy backend:3000
	}

	handle /readyz {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy web:3000
	}
}
