# TuneX — Docker 内部统一 HTTP 入口
#
# 默认生产拓扑：
#   Host Nginx / 宝塔 / 1Panel (:80/:443, TLS)
#      -> 127.0.0.1:${TUNEX_HTTP_PORT:-13000}
#      -> tunex-caddy:80
#      -> backend/web
#
# Caddy 在该模式下只负责 TuneX 应用内部路由，不负责公网 TLS。
# standalone（Caddy 直接占用宿主机 80/443）使用 Caddyfile.prod。

:80 {
	encode zstd gzip

	# Agent 控制面 Socket.IO / WebSocket。
	handle /socket.io/* {
		reverse_proxy backend:3001 {
			# 入口只绑定 127.0.0.1，可安全信任宿主机反代传来的原始请求信息。
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
		}
	}

	handle /healthz {
		reverse_proxy backend:3000
	}

	handle /readyz {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
		}
	}
}
