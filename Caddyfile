# TuneX — Docker 内部统一 HTTP 入口
#
# 默认生产拓扑：
#   Host Nginx / 宝塔 / 1Panel (:80/:443, TLS)
#      -> 127.0.0.1:${TUNEX_HTTP_PORT:-13000}
#      -> tunex-caddy:80
#      -> backend/web
#
# Caddy 在该模式下只负责 TuneX 应用内部路由，不负责公网 TLS。
# standalone（Caddy 直接占用宿主机 80/443）使用 Caddyfile.prod。

{
	servers {
		# 生产默认只有宿主机反代能访问 127.0.0.1 映射入口；Docker 转发后的对端地址属于私网。
		# 启用严格代理链解析，保留真实客户端 IP/协议，同时避免信任客户端伪造的左侧 XFF。
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:80 {
	encode zstd gzip

	# Agent 控制面 Socket.IO / WebSocket。
	handle /socket.io/* {
		reverse_proxy backend:3001 {
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /api/* {
		reverse_proxy backend:3000 {
		}
	}

	handle /healthz {
		reverse_proxy backend:3000
	}

	handle /readyz {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy web:3000 {
		}
	}
}
