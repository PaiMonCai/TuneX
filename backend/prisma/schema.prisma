generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum NodeType {
  in
  out
}

enum Status {
  active
  inactive
}

enum BypassType {
  whitelist
  blacklist
}

enum WorkspaceKind {
  personal
  team
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer
}

/// 策略来源：系统默认（免费基础能力）/ 管理员授予 / 试用 / 付费发放。
/// 支付只影响“哪一条策略被发放”，不参与权限与额度判定本身。
enum PolicySource {
  system_default
  admin_grant
  trial
  purchase
}

/// 流量额度计量周期。
enum TrafficPeriod {
  total
  month
  day
}

model Workspace {
  id               Int               @id @default(autoincrement())
  slug             String            @unique @db.VarChar(191)
  name             String            @db.VarChar(120)
  kind             WorkspaceKind
  personal_user_id Int?              @unique
  personal_user    User?             @relation("PersonalWorkspace", fields: [personal_user_id], references: [id], onDelete: Restrict)
  created_by_id    Int
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  members          WorkspaceMember[]
  invites          WorkspaceInvite[]
  api_keys         WorkspaceApiKey[]
  audit_events     AuditEvent[]
  node_groups      NodeGroup[]
  tunnels          Tunnel[]
  policy_assignments WorkspacePolicyAssignment[]

  @@map("workspace")
}

model WorkspaceMember {
  id           Int           @id @default(autoincrement())
  workspace_id Int
  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user_id      Int
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role         WorkspaceRole
  active       Boolean       @default(true)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  @@unique([workspace_id, user_id])
  @@index([user_id, active])
  @@map("workspace_member")
}

model WorkspaceInvite {
  id            Int           @id @default(autoincrement())
  workspace_id  Int
  workspace     Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  email         String        @db.VarChar(191)
  role          WorkspaceRole
  token_hash    String        @unique @db.Char(64)
  invited_by_id Int
  expires_at    DateTime
  accepted_at   DateTime?
  revoked_at    DateTime?
  created_at    DateTime      @default(now())

  @@index([workspace_id, email])
  @@map("workspace_invite")
}

model WorkspaceApiKey {
  id           Int        @id @default(autoincrement())
  workspace_id Int
  workspace    Workspace  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  name         String     @db.VarChar(120)
  key_hash     String     @unique @db.Char(64)
  prefix       String     @db.VarChar(20)
  scopes       Json
  expires_at   DateTime?
  revoked_at   DateTime?
  created_by_id Int
  created_at   DateTime   @default(now())

  @@index([workspace_id, revoked_at])
  @@map("workspace_api_key")
}

model AuditEvent {
  id            BigInt      @id @default(autoincrement())
  workspace_id  Int
  workspace     Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  actor_user_id Int?
  action        String      @db.VarChar(100)
  resource_type String      @db.VarChar(80)
  resource_id   String?     @db.VarChar(191)
  ip            String?     @db.VarChar(80)
  detail        Json?
  created_at    DateTime    @default(now())

  @@index([workspace_id, created_at])
  @@map("audit_event")
}

/// 能力策略模板：与价格/订单彻底解耦的「功能准入 + 资源额度」事实源。
///
/// 字段语义（PLAN §4.2）：
///   · `0` = 禁止；`null` = 无额外额度限制（仅平台硬上限仍生效）
///   · 空白名单（`[]`）= 无访问；`allow_all` 必须显式为真
///   · 绝不因「没有套餐 / 名单为空」默认放行
model CapabilityPolicy {
  id          Int          @id @default(autoincrement())
  key         String       @unique @db.VarChar(120)
  name        String       @db.VarChar(120)
  description String?      @db.Text
  source      PolicySource @default(system_default)
  /// 新建 workspace 时自动发放的免费模板（个人 / 团队各一条）
  is_default  Boolean      @default(false)
  /// 仅对某类 workspace 生效；null = 个人与团队通用
  applies_to  WorkspaceKind?
  /// 平台硬上限模板：额度作为所有 workspace 的绝对上界，不直接发放
  is_ceiling  Boolean      @default(false)
  status      Status       @default(active)
  /// 策略内容版本；任一字段变化时自增，用于 `policy_revision` 与缓存失效
  revision    Int          @default(1)

  // —— 功能准入（Entitlement）——
  /// 允许的隧道协议；[] = 不允许任何协议
  tunnel_types           Json    @default("[]")
  allow_custom_in_group  Boolean @default(false)
  allow_custom_out_group Boolean @default(false)
  /// 显式允许使用的共享入口/出口节点组 id；null = 仅自有节点组
  allowed_in_group_ids   Json?
  allowed_out_group_ids  Json?
  allow_shared_entry     Boolean @default(false)

  // —— 资源额度（Quota）——
  max_tunnels     Int?
  max_nodes       Int?
  max_members     Int?
  /// 流量额度（字节）；配合 `traffic_period`
  traffic_limit   Float?
  traffic_period  TrafficPeriod @default(total)
  /// 带宽上限（Mbps）
  bandwidth_limit Int?
  /// 单隧道并发客户端上限
  client_limit    Int?
  /// 单隧道 IP 上限
  ip_limit        Int?
  /// 入口 admission 白名单（IP/CIDR）；null = 不启用
  whitelist_ips   Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assignments WorkspacePolicyAssignment[]

  @@index([source, status])
  @@map("capability_policy")
}

/// 把策略模板发放给某个 workspace，并记录来源 / 生效 / 截止 / 撤销。
/// 支付若启用，只负责产生一条 `purchase` 来源的发放记录；
/// 停用支付不影响 `system_default` / `admin_grant` 的既有发放。
model WorkspacePolicyAssignment {
  id           Int              @id @default(autoincrement())
  workspace_id Int
  workspace    Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  policy_id    Int
  policy       CapabilityPolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  source       PolicySource     @default(system_default)
  effective_at DateTime         @default(now())
  /// null = 不设截止（仅管理员显式赋予）
  expires_at   DateTime?
  /// 显式撤销：立即生效，无宽限期
  revoked_at   DateTime?
  granted_by_id Int?
  note         String?          @db.VarChar(255)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  @@unique([workspace_id, policy_id])
  @@index([workspace_id, revoked_at])
  @@map("workspace_policy_assignment")
}

model NodeGroup {
  id                     Int             @id @default(autoincrement())
  token                  String          @unique @default(uuid())
  name                   String          @db.VarChar(255)
  port_range             String?         @db.VarChar(255)
  connect_ip             String?         @db.VarChar(255)
  node_type              NodeType
  load_balance_type      LoadBalanceType @default(round)
  allow_listen_protocol  Boolean         @default(false)
  allow_listen_protocols Json?
  allow_tunnel_types     Json?
  bypass_type            BypassType      @default(blacklist)
  bypass_list            Json?           @db.Json
  admission              Boolean         @default(false)
  block_protocols        Json?
  traffic_rate           Float           @default(1)
  need_out_node_group    Boolean         @default(true)
  allow_out_node_groups  Json?
  allow_in_node_groups   Json?
  order_by               Float           @default(1000)
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  user_id                Int
  user                   User            @relation(fields: [user_id], references: [id])
  workspace_id           Int
  workspace              Workspace       @relation(fields: [workspace_id], references: [id])

  in_tunnels        Tunnel[]         @relation("in_node_group")
  out_tunnels       Tunnel[]         @relation("out_node_group")
  nodes             Node[]
  plans             PlanNodeGroup[]
  grants            NodeGroupGrant[]
  tunnel_chains     TunnelChain[]
  in_node_group_dns InNodeGroupDNS[]

  @@index([workspace_id])
  @@map("node_group")
}

// Shared node groups require an explicit per-user, per-direction grant.
// Ownership is handled separately; no purchase or license relationship.
model NodeGroupGrant {
  id            Int       @id @default(autoincrement())
  user_id       Int
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  node_group_id Int
  node_group    NodeGroup @relation(fields: [node_group_id], references: [id], onDelete: Cascade)
  direction     NodeType
  active        Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@unique([user_id, node_group_id, direction])
  @@index([node_group_id, active])
  @@map("node_group_grant")
}

model Node {
  id          Int      @id @default(autoincrement())
  weight      Int      @default(1)
  status      Status   @default(active)
  node_id     String   @unique @db.VarChar(255)
  connect_ip  String   @db.VarChar(255)
  version     String   @default("unknown") @db.VarChar(255)
  backup      Boolean  @default(false)
  order_by    Float    @default(1000)
  custom_line String?  @db.VarChar(255)
  dns_status  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  node_group_id Int
  node_group    NodeGroup @relation(fields: [node_group_id], references: [id])

  @@map("node")
}

enum LoadBalanceType {
  round
  rand
  fifo
  hash
  ll
  lc
}

enum TunnelType {
  tcp
  mtcp
  udp
  tunex
  mtls
  mwss
  wss
  tls
  quic
}

enum IpType {
  auto
  ipv4
  ipv6
}

enum TunnelCategory {
  port_forward
  remote_port_forward
}

model Tunnel {
  id                         Int             @id @default(autoincrement())
  name                       String          @db.VarChar(255)
  tunnel_type                TunnelType      @default(wss)
  category                   TunnelCategory  @default(port_forward)
  listen_ip                  String?
  listen_port                Int?
  listen_protocol            Json?
  port_conflict_at           DateTime?
  status                     Status          @default(active)
  forward_addresses          Json
  forward_addresses_protocol Json?
  load_balance_type          LoadBalanceType
  ip_type                    IpType          @default(ipv4)
  order_by                   Float           @default(1000)
  ip_limit                   Int?
  client_limit               Int?
  bandwidth_limit            Int?
  traffic                    Float           @default(0)
  traffic_cost               Float           @default(0)
  proxy_protocol             Boolean         @default(false)
  created_at                 DateTime        @default(now())
  updated_at                 DateTime        @updatedAt
  in_node_group_id           Int
  in_node_group              NodeGroup       @relation("in_node_group", fields: [in_node_group_id], references: [id])
  out_node_group_id          Int?
  out_node_group             NodeGroup?      @relation("out_node_group", fields: [out_node_group_id], references: [id])
  user_id                    Int
  user                       User            @relation(fields: [user_id], references: [id])
  workspace_id               Int
  workspace                  Workspace       @relation(fields: [workspace_id], references: [id])

  tunnel_traffic TunnelTraffic[]
  tunnel_chains  TunnelChain[]

  @@unique([listen_port, in_node_group_id])
  @@index([workspace_id])
  @@map("tunnel")
}

model TunnelChain {
  id            Int       @id @default(autoincrement())
  tunnel_id     Int
  tunnel        Tunnel    @relation(fields: [tunnel_id], references: [id])
  node_type     NodeType
  node_group_id Int
  node_group    NodeGroup @relation(fields: [node_group_id], references: [id])

  @@map("tunnel_chain")
}

model User {
  id                       Int                @id @default(autoincrement())
  super_admin              Boolean            @default(false)
  email                    String             @unique
  balance                  Float              @default(0)
  commission_balance       Float              @default(0)
  tg_id                    String?
  uid                      String?
  note                     String?
  tunnels                  Tunnel[]
  parent_id                Int?
  parent                   User?              @relation("UserReferral", fields: [parent_id], references: [id])
  children                 User[]             @relation("UserReferral")
  referral_commission_rate Float?
  referral_first_only      Boolean?
  auto_renew               Boolean            @default(false)
  /// SEC-02（legacy 明文列，保留仅为惰性迁移）。
  ///
  /// 新签发的凭据只写 `api_key_hash`（sha256）。明文列在两处被清空：
  ///  1. 惰性迁移：认证命中存量明文行时同事务写哈希并置本列为 null；
  ///  2. 轮换：rotateKey 覆盖哈希列并置本列为 null。
  /// 因此本列必须可空 + 去掉 `@default(uuid())`（默认值会让 Prisma 的
  /// `db.user.create()` 永不显式写 null，惰性迁移与 seed 都退化成明文落库）。
  /// 唯一索引保留：NULL 可重复，不影响「迁移后所有明文行均为 null」的终态。
  api_key                  String?            @unique
  /// SEC-02：subscription_key 明文列，迁移策略同 api_key（可空、无默认值）。
  subscription_key         String?            @unique
  /// SEC-02：api_key 的 sha256 hex（64 字符）。新签发凭据只落哈希；明文列
  /// （api_key）保留仅用于惰性迁移——认证命中明文行时同事务写入哈希并清空明文。
  api_key_hash             String?            @unique @db.Char(64)
  /// SEC-02：subscription_key 的 sha256 hex；迁移策略同 api_key_hash。
  subscription_key_hash    String?            @unique @db.Char(64)
  notify_subscriptions     Json?
  admin_notify_subscriptions Json?
  node_groups              NodeGroup[]
  personal_workspace       Workspace?       @relation("PersonalWorkspace")
  workspace_memberships    WorkspaceMember[]
  node_group_grants        NodeGroupGrant[]
  status                   Status             @default(active)
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt
  /// TEN-03：邮箱验证时间。NULL = 未验证（老用户与 0.1 阶段软约束兼容）。
  email_verified_at        DateTime?
  email_verifications      EmailVerification[]
  orders                   PlanOrder[]
  topups                   TopupOrder[]
  user_plan                UserPlan?
  balance_logs             BalanceLog[]
  commission_logs          CommissionLog[]
  tickets                  Ticket[]
  ticket_replies           TicketReply[]
  withdraw_requests        WithdrawRequest[]
  dns_providers            DNSProvider[]
  admin_roles              AdminRole[]
  credential               UserCredential?

  @@map("user")
}

model AdminRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  permissions Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  users       User[]

  @@map("admin_role")
}

model UserPlan {
  id            Int       @id @default(autoincrement())
  user_id       Int       @unique
  user          User      @relation(fields: [user_id], references: [id])
  traffic       Float?
  traffic_used  Float     @default(0)
  max_tunnels   Int?
  whitelist_ips Json?
  expired_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  plan_id       Int
  plan          Plan      @relation(fields: [plan_id], references: [id])

  @@map("user_plan")
}

enum BillingCycle {
  month
  quarter
  half_year
  year
  lifetime
}

model Plan {
  id                          Int          @id @default(autoincrement())
  name                        String       @db.VarChar(255)
  description                 String?
  original_price              Float?
  price                       Float
  max_tunnels                 Int?
  traffic                     Int?
  ip_limit                    Int?
  client_limit                Int?
  bandwidth_limit             Int?
  whitelist_limit             Int?
  allow_custom_in_node_group  Boolean
  allow_custom_out_node_group Boolean
  all_in_node_groups          Boolean
  all_out_node_groups         Boolean
  setup_fee                   Float?
  billing_cycle               BillingCycle @default(month)
  status                      Status       @default(active)
  renewable                   Boolean      @default(true)
  stock                       Int?
  order_by                    Float        @default(1000)
  created_at                  DateTime     @default(now())
  updated_at                  DateTime     @updatedAt

  node_groups PlanNodeGroup[]
  orders      PlanOrder[]
  user_plans  UserPlan[]

  @@map("plan")
}

model PlanNodeGroup {
  id            Int       @id @default(autoincrement())
  plan_id       Int
  node_group_id Int
  node_group    NodeGroup @relation(fields: [node_group_id], references: [id])
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  plan Plan @relation(fields: [plan_id], references: [id])

  @@map("plan_node_group")
}

model PlanOrder {
  id         Int         @id @default(autoincrement())
  user_id    Int
  user       User        @relation(fields: [user_id], references: [id])
  plan_id    Int
  plan       Plan        @relation(fields: [plan_id], references: [id])
  price      Float
  balance    Float
  coupon_id  Int?
  coupon     PlanCoupon? @relation(fields: [coupon_id], references: [id])
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  @@map("plan_order")
}

enum TopupOrderStatus {
  pending
  success
  cancelled
}

model TopupOrder {
  id         Int              @id @default(autoincrement())
  user_id    Int
  user       User             @relation(fields: [user_id], references: [id])
  price      Float
  balance    Float            @default(0)
  bonus      Float            @default(0)
  payment_id Int
  payment    Payment          @relation(fields: [payment_id], references: [id])
  pay_url    String           @db.Text
  status     TopupOrderStatus @default(pending)
  order_id   String           @unique @db.VarChar(255)
  trade_id   String?          @unique @db.VarChar(255)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  @@map("topup_order")
}

enum TopupActivityType {
  percentage
  fixed
}

model TopupActivity {
  id          Int               @id @default(autoincrement())
  type        TopupActivityType
  value       Float
  min_amount  Float?
  max_amount  Float?
  valid_start DateTime?
  valid_end   DateTime?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  @@map("topup_activity")
}

model TunnelTraffic {
  id           Int      @id @default(autoincrement())
  tunnel_id    Int
  tunnel       Tunnel   @relation(fields: [tunnel_id], references: [id])
  traffic      Float
  traffic_cost Float
  date         DateTime

  @@index([date])
  @@unique([tunnel_id, date])
  @@map("tunnel_traffic")
}

enum SystemConfigName {
  MIN_TOPUP_AMOUNT
  NOTICE
  NOTICE_POPUP
  NOTICE_POPUP_INTERVAL_HOURS
  SITE_NAME
  SITE_DESCRIPTION
  ALLOW_REGISTER
  LOGO_URL
  HIDE_NODE_STATUS
  AUTO_UPDATE_AGENT
  CHATWOOT_BASE_URL
  CHATWOOT_TOKEN
  TUNNEL_TRAFFIC_RETENTION_DAYS
  HIDE_FOOTER
  HIDE_DOCS
  LANDING_PAGE_URL
  REFERRAL_COMMISSION_RATE
  REFERRAL_FIRST_ONLY
  REFERRAL_MODE
  OBSERVER_PERIOD
  EMAIL_PROVIDER
  SMTP_HOST
  SMTP_PORT
  SMTP_SECURE
  SMTP_USER
  SMTP_PASS
  SMTP_FROM
  RESEND_API_KEY
  RESEND_FROM
  MIN_WITHDRAW_AMOUNT
  WITHDRAW_METHODS
  LIMIT_SCOPE
  ENABLE_SUBSCRIPTION
}

model SystemConfig {
  id         Int              @id @default(autoincrement())
  name       SystemConfigName @unique
  value      String           @db.Text
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  @@map("config")
}

enum PaymentMethod {
  epay
  bepusdt
  heleket
}

model Payment {
  id          Int           @id @default(autoincrement())
  fixed_fee   Float?
  percent_fee Float?
  name        String        @db.VarChar(255)
  url         String        @db.VarChar(255)
  config      Json
  method      PaymentMethod
  type        String?       @db.VarChar(255)
  status      Status        @default(active)
  order_by    Float         @default(1000)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  topups      TopupOrder[]

  @@map("payment")
}

enum CouponType {
  percentage
  fixed
}

model PlanCoupon {
  id               Int           @id @default(autoincrement())
  code             String        @db.VarChar(255)
  type             CouponType
  valid_cycle      BillingCycle?
  value            Float
  valid_start      DateTime?
  valid_end        DateTime?
  max_use          Int?
  max_use_per_user Int?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  orders PlanOrder[]

  @@map("plan_coupon")
}

enum BalanceLogType {
  topup
  plan
  commission_transfer
  admin_adjust
}

model BalanceLog {
  id         Int            @id @default(autoincrement())
  user_id    Int
  user       User           @relation(fields: [user_id], references: [id])
  balance    Float
  amount     Float
  type       BalanceLogType
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@map("balance_log")
}

enum CommissionLogType {
  referral
  transfer
  withdraw
  admin_adjust
}

model CommissionLog {
  id         Int               @id @default(autoincrement())
  user_id    Int
  user       User              @relation(fields: [user_id], references: [id])
  balance    Float
  amount     Float
  type       CommissionLogType
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  @@map("commission_log")
}

enum WithdrawStatus {
  pending
  approved
  rejected
}

model WithdrawRequest {
  id         Int            @id @default(autoincrement())
  user_id    Int
  user       User           @relation(fields: [user_id], references: [id])
  amount     Float
  method     String         @db.VarChar(255)
  account    String         @db.Text
  status     WithdrawStatus @default(pending)
  remark     String?        @db.Text
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  @@map("withdraw_request")
}

enum TicketStatus {
  open
  closed
}

model Ticket {
  id         Int           @id @default(autoincrement())
  title      String        @db.VarChar(255)
  content    String        @db.Text
  status     TicketStatus  @default(open)
  user_id    Int
  user       User          @relation(fields: [user_id], references: [id])
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  replies    TicketReply[]

  @@map("ticket")
}

model TicketReply {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  is_admin   Boolean  @default(false)
  ticket_id  Int
  ticket     Ticket   @relation(fields: [ticket_id], references: [id])
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("ticket_reply")
}

model InNodeGroupDNS {
  id               Int         @id @default(autoincrement())
  in_node_group_id Int
  in_node_group    NodeGroup   @relation(fields: [in_node_group_id], references: [id])
  dns_provider_id  Int
  dns_provider     DNSProvider @relation(fields: [dns_provider_id], references: [id])
  ttl              Int         @default(60)
  ipv6             Boolean     @default(false)
  status           Status      @default(active)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@map("in_node_group_dns")
}

enum DNSProviderType {
  cloudflare
  huawei
}

model DNSProvider {
  id                Int              @id @default(autoincrement())
  name              String           @db.VarChar(255)
  type              DNSProviderType
  config            Json
  user_id           Int
  user              User             @relation(fields: [user_id], references: [id])
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  in_node_group_dns InNodeGroupDNS[]

  @@map("dns_provider")
}

/// 审计事件里的操作者类型。
enum AuditActorType {
  /// 普通登录用户
  user
  /// 平台超级管理员
  super_admin
  /// 具备后台角色的管理员
  admin
  /// 系统/后台任务（worker、cron）
  system
  /// 未认证请求（登录/注册/支付回调等）
  anonymous
}

/// 操作审计日志（append-only）。
///
/// 写入由 `src/middlewares/audit.ts` 在响应后 fire-and-forget 完成；
/// 记录「谁（actor）在什么上下文（ip/ua）对什么资源（resource/id）做了什么
/// （action＝`METHOD 归一化路径`）以及结果（status）」。
/// 不落请求体：避免把密码/卡片等敏感字段带进日志。
model AuditLog {
  id          Int            @id @default(autoincrement())
  actor_type  AuditActorType @default(anonymous)
  actor_id    Int?
  actor_email String?        @db.VarChar(255)
  /// 形如 `POST /api/admin/users/:id`（数字段归一化为 :id）
  action      String         @db.VarChar(191)
  /// 资源名，如 `admin/users`、`tunnels`、`auth/login`
  resource    String         @db.VarChar(64)
  /// 资源主键（路径中首个数字段），无则为 null
  resource_id String?        @db.VarChar(64)
  method      String         @db.VarChar(10)
  path        String         @db.VarChar(255)
  status      Int
  ip          String?        @db.VarChar(64)
  user_agent  String?        @db.VarChar(255)
  /// 附加结构化信息（默认 null；不要让调用方写入敏感字段）
  metadata    Json?
  created_at  DateTime       @default(now())

  @@index([actor_id])
  @@index([resource, resource_id])
  @@index([created_at])
  @@map("audit_log")
}

/// 密码凭证表。
/// 原版 `user` 表无密码列（Stack Auth 托管），本实现自签本地 JWT 需本地凭证，
/// 故拆表存放，`user` 表列结构保持与原版 100% 一致（零列改动）。
model UserCredential {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  password   String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("user_credential")
}

/// TEN-03：邮箱验证 / 密码重置共用的一次性令牌表。
///
/// 设计（对齐 workspace_invite 的既有安全取向）：
///  · **只存哈希**：`token_hash` 为 sha256(token) 的 hex；明文 token 只在邮件链接里出现一次。
///  · **单次使用**：`used_at` 置位即失效；重复使用返回同一「无效或已使用」响应，不区分状态。
///  · **过期**：`expires_at` 到期即失效；验证邮件 24h，密码重置 1h。
///  · **同邮箱发新 token 时旧的立即作废**（仍是「一次一封有效信」的语义）。
///  · purpose 区分用途，杜绝「用验证链接改密码」之类的跨用途重放。
model EmailVerification {
  id         Int       @id @default(autoincrement())
  user_id    Int
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  email      String    @db.VarChar(191)
  purpose    String    @db.VarChar(32) // email_verify | password_reset
  token_hash String    @unique @db.Char(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, purpose])
  @@index([email, purpose])
  @@index([expires_at])
  @@map("email_verification")
}
