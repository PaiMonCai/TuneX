generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum NodeType {
  in
  out
}

/// v3 节点角色（WP1，DEVELOPMENT.md §2.1）：节点能力的最终真相源。
///
/// legacy `NodeGroup.node_type` 只作兼容显示，v3 新逻辑不得把它当作方向判定的
/// 最终依据；同一节点组内完全可以混挂 ingress / egress / both 三种 Node。
enum NodeRole {
  /// 入口：可单独以 DIRECT 模式服务，也可作为 RELAY 的入口侧
  ingress
  /// 出口：不能单独服务，必须由入口节点把流量转入；目标由 EgressPool 维护
  egress
  /// 兼任入口与出口（单机测试 / 开发环境）
  both
}

/// v3 隧道模式（DEVELOPMENT.md §2.1）。
enum TunnelMode {
  /// 单跳：客户端 → 入口节点 → 目标（目标落在 tunnel.remote_host/remote_port）
  direct
  /// 双跳：客户端 → 入口节点 → 出口节点 → EgressPool 目标池
  relay
}

/// v3 第一版出口目标负载均衡策略（DEVELOPMENT.md §2.2）。
///
/// 与 legacy `LoadBalanceType`（round/rand/fifo/hash/ll/lc）是**两套列**：
/// 旧列继续服务现有 DIRECT 配置下发，本枚举只描述 v3 EgressPool，
/// 因此不存在枚举膨胀或旧值被 reinterpret 的风险。
enum LBStrategy {
  round
  rand
  weighted_round
}

/// V4 托管 Node 生命周期（DEVELOPMENT.md §13.4.1）。
///
/// 与 legacy `Status`（active/inactive，连接态）**刻意分开**：§13.4.1 硬约束
/// 「不得复用现有 legacy Node.status 同时表示连接与生命周期」。
///   · Status 由 offline-detector 翻 active/inactive，是**事实**；
///   · NodeLifecycle 由用户/管理员设置，是**期望**。
/// 「维护中的节点掉线」必须两件事同时成立，挤一列必然互相覆盖。
enum NodeLifecycle {
  /// 正常承载 Forward；接受新业务；可作为 Ingress/Egress 候选
  active
  /// 服务器升级/重启/检查：不接受新业务，存量 runtime 尽量保持不删
  maintenance
  /// 明确不再接受新业务；不作为新 Forward/新 Binding/迁移目标
  disabled
  /// 删除前的退役阶段：依赖锁定展示，仅依赖清空后才允许物理删除
  retiring
}

/// 端口租约方向（DEVELOPMENT.md §5.1）。
///
/// 方向只是租约元数据：物理唯一性由 `UNIQUE(node_id, port)` 保证，
/// 与方向无关——否则 BOTH 节点会用同一端口双绑 ingress/egress。
enum LeaseType {
  ingress
  egress
}

/// v3 隧道 apply 状态机（DEVELOPMENT.md §4.1）—— **有意不加 Prisma 枚举**。
///
/// 状态值由 `Tunnel.apply_status`（VARCHAR(20)）承载，原因见该列注释：
/// DB 列先落地，枚举随 WP8 编排器一起收敛，避免现在加枚举、
/// WP8 又要 `ALTER` 改它。此处只把状态语义钉在文档里，作为 WP8 的契约：
///
///   pending    —— 已生成期望状态（desired_status + config_revision），尚未下发
///   applying   —— 已下发，等待 Agent ACK
///   active     —— RELAY 两端（先 egress 后 ingress）均 ACK 同一 revision
///   error      —— 任一步失败：保留记录，原因见 apply_error_code / apply_error
///   suspended  —— 节点失效 / 管理员暂停后的可解释状态（不物理删除隧道数据）
///
/// Tunnel 是**期望状态**，不是一次 HTTP 操作：失败必须保留记录 +
/// 结构化错误，前端展示原因并允许 Retry，禁止物理删除。

enum Status {
  active
  inactive
}

enum BypassType {
  whitelist
  blacklist
}

enum WorkspaceKind {
  personal
  team
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer
}

/// 策略来源：系统默认（免费基础能力）/ 管理员授予 / 试用 / 付费发放。
/// 支付只影响“哪一条策略被发放”，不参与权限与额度判定本身。
enum PolicySource {
  system_default
  admin_grant
  trial
  purchase
}

/// 流量额度计量周期。
enum TrafficPeriod {
  total
  month
  day
}

model Workspace {
  id               Int               @id @default(autoincrement())
  slug             String            @unique @db.VarChar(191)
  name             String            @db.VarChar(120)
  kind             WorkspaceKind
  personal_user_id Int?              @unique
  personal_user    User?             @relation("PersonalWorkspace", fields: [personal_user_id], references: [id], onDelete: Restrict)
  created_by_id    Int
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  members          WorkspaceMember[]
  invites          WorkspaceInvite[]
  api_keys         WorkspaceApiKey[]
  audit_events     AuditEvent[]
  node_groups      NodeGroup[]
  tunnels          Tunnel[]
  policy_assignments WorkspacePolicyAssignment[]
  custom_roles     WorkspaceCustomRole[]
  /// V5-WP17（契约 F6）：该租户拥有的 DNS 凭据。NULL 归属的 provider 是平台级，
  /// 不在任何租户的列表里。
  dns_providers    DNSProvider[]     @relation("workspace_dns_providers")
  /// V5-WP20-2（契约 §3.5.2）：套餐归属的唯一真相。「一个租户一份订阅」由
  /// `PlanSubscription.workspace_id @unique` 保证。
  plan_subscription PlanSubscription?
  /// V5-WP20-2（契约 §3.5.4）：本租户名下的购买订单（历史行可为 NULL = 未归属，R5）。
  plan_orders      PlanOrder[]

  @@map("workspace")
}

model WorkspaceMember {
  id           Int           @id @default(autoincrement())
  workspace_id Int
  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user_id      Int
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// 基础角色（始终非空）：自定义角色未生效时的回落值，也是「越权判定」的兜底。
  /// role_id 为 NULL 时它单独决定权限；非空时权限由 custom_role.permissions 决定，
  /// 本列退化为 fail-closed 的兜底（自定义角色被删时回落，见迁移里的 SET NULL）。
  role         WorkspaceRole
  /// TEAM-01：自定义角色外键。NULL = 使用固定四角色；非空 = 以自定义角色权限为准。
  /// 用外键而不是把 `custom:<id>` 塞进 role 枚举列：枚举列改字符串会破坏全仓
  /// `role === "owner"` 的类型与比较，且悬挂字符串等于「无权限」而非报错。
  role_id      Int?
  custom_role  WorkspaceCustomRole? @relation(fields: [role_id], references: [id], onDelete: SetNull)
  active       Boolean       @default(true)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  @@unique([workspace_id, user_id])
  @@index([user_id, active])
  @@index([role_id])
  @@map("workspace_member")
}

/// TEAM-01 自定义团队角色：在固定四角色之上按「资源 × 动作」细粒度授权。
///
/// 权限模型（services/workspace.ts 的 WORKSPACE_PERMISSIONS 为单一真相源）：
///   tunnel:read / tunnel:create / tunnel:update / tunnel:delete
///   node:read / node:manage
///   member:read / member:manage
///   settings:read / settings:manage
///   audit:read
///
/// 存储形态是**白名单后的布尔映射**（未知键在写入前被丢弃，与 permissions.ts 的
/// sanitizePermissions 同取向），因此 permissions 里只会出现上表 11 个键。
/// 判定侧对「缺键 / 非布尔 / 角色不存在」一律 fail-closed（拒绝），不默认放行。
model WorkspaceCustomRole {
  id            Int              @id @default(autoincrement())
  workspace_id  Int
  workspace     Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  name          String           @db.VarChar(60)
  description   String?          @db.VarChar(255)
  permissions   Json
  created_by_id Int
  created_by    User             @relation("WorkspaceCustomRoleCreator", fields: [created_by_id], references: [id], onDelete: Cascade)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  members       WorkspaceMember[]

  @@unique([workspace_id, name])
  @@index([workspace_id])
  @@map("workspace_custom_role")
}

model WorkspaceInvite {
  id            Int           @id @default(autoincrement())
  workspace_id  Int
  workspace     Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  email         String        @db.VarChar(191)
  role          WorkspaceRole
  token_hash    String        @unique @db.Char(64)
  invited_by_id Int
  expires_at    DateTime
  accepted_at   DateTime?
  revoked_at    DateTime?
  created_at    DateTime      @default(now())

  @@index([workspace_id, email])
  @@map("workspace_invite")
}

model WorkspaceApiKey {
  id           Int        @id @default(autoincrement())
  workspace_id Int
  workspace    Workspace  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  name         String     @db.VarChar(120)
  key_hash     String     @unique @db.Char(64)
  prefix       String     @db.VarChar(20)
  scopes       Json
  expires_at   DateTime?
  revoked_at   DateTime?
  created_by_id Int
  created_at   DateTime   @default(now())

  @@index([workspace_id, revoked_at])
  @@map("workspace_api_key")
}

model AuditEvent {
  id            BigInt      @id @default(autoincrement())
  workspace_id  Int
  workspace     Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  actor_user_id Int?
  action        String      @db.VarChar(100)
  resource_type String      @db.VarChar(80)
  resource_id   String?     @db.VarChar(191)
  ip            String?     @db.VarChar(80)
  detail        Json?
  created_at    DateTime    @default(now())

  @@index([workspace_id, created_at])
  @@map("audit_event")
}

/// 能力策略模板：与价格/订单彻底解耦的「功能准入 + 资源额度」事实源。
///
/// 字段语义（PLAN §4.2）：
///   · `0` = 禁止；`null` = 无额外额度限制（仅平台硬上限仍生效）
///   · 空白名单（`[]`）= 无访问；`allow_all` 必须显式为真
///   · 绝不因「没有套餐 / 名单为空」默认放行
model CapabilityPolicy {
  id          Int          @id @default(autoincrement())
  key         String       @unique @db.VarChar(120)
  name        String       @db.VarChar(120)
  description String?      @db.Text
  source      PolicySource @default(system_default)
  /// 新建 workspace 时自动发放的免费模板（个人 / 团队各一条）
  is_default  Boolean      @default(false)
  /// 仅对某类 workspace 生效；null = 个人与团队通用
  applies_to  WorkspaceKind?
  /// 平台硬上限模板：额度作为所有 workspace 的绝对上界，不直接发放
  is_ceiling  Boolean      @default(false)
  status      Status       @default(active)
  /// 策略内容版本；任一字段变化时自增，用于 `policy_revision` 与缓存失效
  revision    Int          @default(1)

  // —— 功能准入（Entitlement）——
  /// 允许的隧道协议；[] = 不允许任何协议
  tunnel_types           Json    @default("[]")
  allow_custom_in_group  Boolean @default(false)
  allow_custom_out_group Boolean @default(false)
  /// 显式允许使用的共享入口/出口节点组 id；null = 仅自有节点组
  allowed_in_group_ids   Json?
  allowed_out_group_ids  Json?
  allow_shared_entry     Boolean @default(false)

  // —— 资源额度（Quota）——
  max_tunnels     Int?
  max_nodes       Int?
  max_members     Int?
  /// 流量额度（字节）；配合 `traffic_period`
  traffic_limit   Float?
  traffic_period  TrafficPeriod @default(total)
  /// 带宽上限（Mbps）
  bandwidth_limit Int?
  /// 单隧道并发客户端上限
  client_limit    Int?
  /// 单隧道 IP 上限
  ip_limit        Int?
  /// 入口 admission 白名单（IP/CIDR）；null = 不启用
  whitelist_ips   Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assignments WorkspacePolicyAssignment[]
  /// V5-WP20-4：把本策略作为商品出售的套餐（`Plan.policy_id` 的反向关系）。
  /// 与 `assignments` 分开：发放是「谁在用」，这里是「哪个商品对应它」。
  plans       Plan[]

  @@index([source, status])
  @@map("capability_policy")
}

/// 把策略模板发放给某个 workspace，并记录来源 / 生效 / 截止 / 撤销。
/// 支付若启用，只负责产生一条 `purchase` 来源的发放记录；
/// 停用支付不影响 `system_default` / `admin_grant` 的既有发放。
model WorkspacePolicyAssignment {
  id           Int              @id @default(autoincrement())
  workspace_id Int
  workspace    Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  policy_id    Int
  policy       CapabilityPolicy @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  source       PolicySource     @default(system_default)
  effective_at DateTime         @default(now())
  /// null = 不设截止（仅管理员显式赋予）
  expires_at   DateTime?
  /// 显式撤销：立即生效，无宽限期
  revoked_at   DateTime?
  granted_by_id Int?
  note         String?          @db.VarChar(255)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  @@unique([workspace_id, policy_id])
  @@index([workspace_id, revoked_at])
  @@map("workspace_policy_assignment")
}

model NodeGroup {
  id                     Int             @id @default(autoincrement())
  token                  String          @unique @default(uuid())
  name                   String          @db.VarChar(255)
  port_range             String?         @db.VarChar(255)
  connect_ip             String?         @db.VarChar(255)
  node_type              NodeType
  load_balance_type      LoadBalanceType @default(round)
  allow_listen_protocol  Boolean         @default(false)
  allow_listen_protocols Json?
  allow_tunnel_types     Json?
  bypass_type            BypassType      @default(blacklist)
  bypass_list            Json?           @db.Json
  admission              Boolean         @default(false)
  block_protocols        Json?
  traffic_rate           Float           @default(1)
  need_out_node_group    Boolean         @default(true)
  allow_out_node_groups  Json?
  allow_in_node_groups   Json?
  order_by               Float           @default(1000)
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  user_id                Int
  user                   User            @relation(fields: [user_id], references: [id])
  workspace_id           Int
  workspace              Workspace       @relation(fields: [workspace_id], references: [id])

  in_tunnels        Tunnel[]         @relation("in_node_group")
  out_tunnels       Tunnel[]         @relation("out_node_group")
  nodes             Node[]
  plans             PlanNodeGroup[]
  grants            NodeGroupGrant[]
  tunnel_chains     TunnelChain[]
  in_node_group_dns InNodeGroupDNS[]

  @@index([workspace_id])
  @@map("node_group")
}

// Shared node groups require an explicit per-user, per-direction grant.
// Ownership is handled separately; no purchase or license relationship.
model NodeGroupGrant {
  id            Int       @id @default(autoincrement())
  user_id       Int
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  node_group_id Int
  node_group    NodeGroup @relation(fields: [node_group_id], references: [id], onDelete: Cascade)
  direction     NodeType
  active        Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@unique([user_id, node_group_id, direction])
  @@index([node_group_id, active])
  @@map("node_group_grant")
}

model Node {
  id          Int      @id @default(autoincrement())
  weight      Int      @default(1)
  status      Status   @default(active)
  /// 用户可读节点名/标签，可改名；不再承担物理 Agent 身份。
  node_id     String   @unique @db.VarChar(255)
  /// Panel 生成且不可变的物理 Agent 唯一 ID。角色可在 ingress/egress/both 间调整，
  /// agent_id 不随角色、hostname、显示名变化。
  agent_id    String   @unique @default(uuid()) @db.VarChar(64)
  /// Panel 可先创建未注册节点；首次 enrollment 后写入面板观察到的连接 IP。
  connect_ip  String?  @db.VarChar(255)
  version     String   @default("unknown") @db.VarChar(255)
  backup      Boolean  @default(false)
  order_by    Float    @default(1000)
  custom_line String?  @db.VarChar(255)
  dns_status  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  node_group_id Int
  /// V5-WP17.1：以它为首选入口的 Forward（见 Tunnel.preferred_ingress_node_id）。
  preferred_ingress_tunnels Tunnel[] @relation("preferred_ingress_node")
  /// task-43：把这台节点**列进入口成员次序**的 Forward（意图行）。
  ingress_member_intents ForwardIngressMember[]
  node_group    NodeGroup @relation(fields: [node_group_id], references: [id])

  // ── v3 增量字段（WP1，全部可空 → expand-and-contract，见迁移 20260926040000）──
  //
  // role 可空的理由：存量行的真实角色无从推断（一个节点组里既跑入口又跑出口的
  // 混挂很常见），WP2 的确定性回填策略是「不改 / 不猜」，由管理员在面板显式
  // 设置。因此 v3 代码必须把 `role === null` 当作「尚未声明角色」处理，而不是
  // 默认成 ingress——默认值会让未声明的节点被误当入口参与调度。
  role          NodeRole?
  /// 最近一次心跳时间。NULL = 从未心跳。用于面板展示与离线判定，不替代
  /// offline-detector 的 Redis 防抖（那层才负责翻转 node.status）。
  last_seen_at  DateTime?
  /// 可分配端口区间（v3 NodePortLease 的分配域）。NULL = 未配置，
  /// 分配服务必须拒绝在未配置区间上分配，而不是回落到节点组 port_range
  /// ——后者是给 legacy DIRECT 整组下发用的，不是 per-node 所有权。
  port_range_min Int?
  port_range_max Int?
  /// egress/both 节点上 EgressPool 的默认负载均衡策略；NULL = 使用分配策略时的
  /// 缺省值（round）。池内策略优先于本字段。
  lb_strategy   LBStrategy?

  // ── v3 增量字段（WP7：per-node credential，见迁移 20260925120000）──
  //
  // 节点凭据为「一节点一凭证」，与 node_group.token（一组一凭证）分工：
  //   · node_group.token 声明「这个 Agent 属于哪个组」，决定配置下发范围；
  //   · node_credential_hash 声明「这个 Agent 就是节点 N 本人」，决定控制面
  //     的 node/agent 资源谁能指挥（A token 不能冒充 B 的实现点）。
  // 只存 sha256(token) hex（64 字符，`CHAR(64)` 唯一索引）：拖库拿不到可用
  // 凭据，与 user.api_key_hash / email_verification.token_hash 同一取向。
  // 明文只在 rotate 响应里出现一次，之后任何路径（日志、审计、错误回显）
  // 都不再携带它。
  //
  // 可空理由（expand-and-contract）：存量节点从未签发节点凭据，`NULL` =
  // 「尚未签发」。认证遇到 NULL 必须**拒绝**（fail-closed），不能回落到
  // node_group.token —— 否则一个泄露的组 token 就能冒充组内任意节点。
  /// `sha256(credential)` hex；NULL = 尚未签发节点凭据
  node_credential_hash String?        @unique @db.Char(64)
  /// 最近一次凭据轮换时刻；rotate 时刷新，供面板展示与审计对齐
  credential_rotated_at DateTime?
  /// true = 已撤销：任何重连一律拒绝（GodD「revoked token 不能重连」）
  credential_revoked    Boolean       @default(false)
  /// 最近一次 rejected 认证时刻：供 rotate 时识别「谁还在拿旧 token 敲门」
  credential_last_rejected_at DateTime?

  // ── V4 增量字段（WP5 Node lifecycle，见迁移 20260927000000_v4_node_lifecycle）──
  //
  // §13.4.1 三层状态里的 **Lifecycle**：用户/管理员声明的期望管理状态。它与
  // 上面的 legacy `status`（连接态：offline-detector 翻转它）是**两个正交维度**，
  // 硬约束禁止复用同一列——「维护中的节点掉线」必须能同时表达两件事，挤在
  // 一列里就会互相覆盖。
  //
  // 为什么默认 `active` 而不是像 role 那样留空：存量节点今天确实在正常承载
  // Forward，`active` 是把这个**已知现状**写成默认值，不是推理未知值
  // （对比 role：存量行的真实角色无从推断，那个才必须留 NULL）。
  //
  // retirement 是单向门（见 services/node-lifecycle.ts 的 LIFECYCLE_TRANSITIONS）：
  // retiring → 任意非删除状态一律拒绝，退出路径只有「清空依赖后物理删除」。
  lifecycle           NodeLifecycle @default(active)
  /// 最近一次 lifecycle 变更时刻；供面板展示「维护了多久」与审计对齐
  lifecycle_updated_at DateTime?
  /// 进入 maintenance / retiring 的原因（用户填写，纯备注，不参与判定）
  lifecycle_note       String?      @db.VarChar(255)

  egress_pools    EgressPool[]
  port_leases     NodePortLease[]
  ingress_tunnels Tunnel[]      @relation("ingress_node")
  egress_tunnels  Tunnel[]      @relation("egress_node")
  enrollments     NodeEnrollment[]
  bound_egresses  NodeBinding[] @relation("binding_ingress")
  bound_ingresses NodeBinding[] @relation("binding_egress")
  /// 节点凭据状态快照（版本 / 角色 / 端口占用 / 隧道列表），见 model NodeStateReport。
  /// 每节点一行：`@@unique([node_id])` 保证 Agent 断线重连后恢复的是自己那一份。
  state_report   NodeStateReport?
  /// V5.2 WP5：该节点上报的目标观测（每个 (节点, 目标) 一行）。
  target_observations TargetObservation[]
  /// V5-WP19-B：该节点的观测**档案** —— 原始样本（24h）+ 小时桶（30d）。
  /// 与上面的投影**互不写入**：档案永不被健康判定读取（契约 D3/D4）。
  latency_samples TargetLatencySample[]
  latency_buckets TargetLatencyHourly[]
  /// V5.3 WP9：该节点当前持有的归属租约。
  placement_leases PlacementLease[]
  /// V5.4 WP12：作为中间跳承载的 Forward。
  middle_hops Tunnel[] @relation("middle_node")

  @@index([role])
  // V5-WP17：这两条索引**只存在于迁移里**，schema 一直没有声明它们 —— 后果不是"缺个索引"，
  // 而是**任何人跑一次 `migrate dev`，Prisma 都会把它们当成多余的东西删掉**：一条在
  // `credential_revoked`（认证/准入判定），一条在 `lifecycle`（维护态过滤）。
  // 漂移检查实测过一次（`migrate diff --from-migrations --to-schema-datamodel`），
  // 加上这两行之后归零。它们早已在库里，所以**不需要新迁移**。
  @@index([credential_revoked])
  @@index([lifecycle])
  @@map("node")
}

/// Panel 创建 Node 后签发的短时一次性 enrollment。
/// 明文 token 只返回一次；数据库只存 sha256(token)。
model NodeEnrollment {
  id         Int      @id @default(autoincrement())
  node_id    Int
  node       Node     @relation(fields: [node_id], references: [id], onDelete: Cascade)
  token_hash String   @unique @db.Char(64)
  expires_at DateTime
  used_at    DateTime?
  revoked_at DateTime?
  created_at DateTime @default(now())

  @@index([node_id, expires_at])
  @@index([expires_at, used_at, revoked_at])
  @@map("node_enrollment")
}

/// 用户产品层的 Ingress → Egress 绑定。
/// PortForward 选择出口前必须先存在这条绑定；Tunnel 仍是内部 runtime 对象。
model NodeBinding {
  id              Int      @id @default(autoincrement())
  ingress_node_id Int
  egress_node_id  Int
  ingress_node    Node     @relation("binding_ingress", fields: [ingress_node_id], references: [id], onDelete: Cascade)
  egress_node     Node     @relation("binding_egress", fields: [egress_node_id], references: [id], onDelete: Cascade)
  created_at      DateTime @default(now())

  @@unique([ingress_node_id, egress_node_id])
  @@index([egress_node_id])
  @@map("node_binding")
}

enum LoadBalanceType {
  round
  rand
  fifo
  hash
  ll
  lc
}

enum TunnelType {
  tcp
  mtcp
  udp
  tunex
  mtls
  mwss
  wss
  tls
  quic
}

enum IpType {
  auto
  ipv4
  ipv6
}

enum TunnelCategory {
  port_forward
  remote_port_forward
}

model Tunnel {
  id                         Int             @id @default(autoincrement())
  name                       String          @db.VarChar(255)
  tunnel_type                TunnelType      @default(wss)
  category                   TunnelCategory  @default(port_forward)
  listen_ip                  String?
  listen_port                Int?
  listen_protocol            Json?
  port_conflict_at           DateTime?
  status                     Status          @default(active)
  forward_addresses          Json
  forward_addresses_protocol Json?
  load_balance_type          LoadBalanceType
  ip_type                    IpType          @default(ipv4)
  order_by                   Float           @default(1000)
  ip_limit                   Int?
  client_limit               Int?
  bandwidth_limit            Int?
  traffic                    Float           @default(0)
  traffic_cost               Float           @default(0)
  proxy_protocol             Boolean         @default(false)
  created_at                 DateTime        @default(now())
  updated_at                 DateTime        @updatedAt
  in_node_group_id           Int
  in_node_group              NodeGroup       @relation("in_node_group", fields: [in_node_group_id], references: [id])
  out_node_group_id          Int?
  out_node_group             NodeGroup?      @relation("out_node_group", fields: [out_node_group_id], references: [id])
  user_id                    Int
  user                       User           @relation(fields: [user_id], references: [id])
  workspace_id               Int
  workspace                  Workspace      @relation(fields: [workspace_id], references: [id])

  tunnel_chains  TunnelChain[]
  /// task-43：**按 Forward 自定义的入口成员次序**（意图，不是事实）。
  ingress_member_intents ForwardIngressMember[]

  // ── v3 增量字段（WP1，expand-and-contract：全部可空，见迁移 20260926040000）──
  //
  // tunnel_mode 可空，但**迁移会把所有存量行回填成 `direct`**（不存在存量
  // RELAY，见迁移注释），因此「NULL」在存量库里只是瞬态，新行由控制面显式写入。
  // 可空而非 NOT NULL DEFAULT 'direct' 的理由：让「未迁移到 v3 语义」这件事在
  // 类型层面可区分——读代码的人看到 `tunnel_mode === null` 就知道该行不是
  // 被 v3 显式声明过的，而不是要靠「值恰好等于默认值」去猜。
  tunnel_mode TunnelMode?
  /// V5-WP0 canonical product protocol. `tunnel_type` above remains a legacy
  /// compatibility projection; new Forward admission/runtime decisions must use
  /// this field. NULL is reserved for non-Forward/old pre-backfill rows.
  forward_protocol String? @db.VarChar(16)

  // ── V5-WP5-A1 TLS 前端（DEVELOPMENT.md §6.1 语义契约）──
  //
  // 证书归运维所有，以**节点上的文件**形式存在；这里只存路径。
  //
  // 为什么控制面不存密钥 material：
  //   · 面板没有 per-resource secret store，新建一套会与 node_credential +
  //     部署层 env Fernet 形成第三套密钥系统（§1.1 禁止第二份真相）；
  //   · redaction 按形状删除 PEM 私钥块，是**兜底**而不是唯一防线：让密钥只以
  //     路径形式流经控制面，它就没有机会进入日志/诊断/Support Bundle。
  //
  // 两列都可空且无默认值：只有 protocol=tls 的行才会填，其余行 NULL 是明确事实。
  /// tls 监听使用的证书文件路径（节点本地；NULL = 非 tls）
  tls_cert_path   String? @db.VarChar(512)
  /// tls 监听使用的私钥文件路径（节点本地；NULL = 非 tls）
  tls_key_path    String? @db.VarChar(512)

  // ── V5-WP17 DDNS 前门（docs/v5-wp17-entry-exit-group-ddns-contract.md §3 F3/F4/F7）──
  //
  // 为什么**挂 Forward 而不是 Route Profile**（F3）：模板与域名是 N:1——同一个 Profile 可以
  // 被多条 Forward apply，域名若属模板就会互相打架；而域名必须随 config_revision 被 ACK，
  // 落在 tunnel 行上才是同一份 desired。
  //
  // 为什么值来源只认 node.connect_ip（F3）：写进 DNS 的是"客户端该连哪里"，那正是面板
  // 观察到的连接 IP。`connect_ip IS NULL` ⇒ **拒绝写**（dns_unbound_address），绝不回落
  // listen_ip 或节点组的遗留列——回落就是猜地址。
  //
  // 全部可空 + 无默认值：只有配置了前门域名的 Forward 才填，其余行 NULL 是**明确事实**
  //（"这条 Forward 没有前门"），不是"还没填"。
  /// 前门域名；NULL = 这条 Forward 没有前门
  dns_domain           String?       @db.VarChar(255)
  /// 记录类型。多值只允许 A/AAAA；CNAME 只允许单值（F4）
  dns_record_type      DNSRecordType?
  /// 多入口（记录集 = 可用入口集合，首选）还是单活跃（记录集 = 当前 owner）（F4）
  dns_mode             DNSMode?
  dns_provider_id      Int?
  dns_provider         DNSProvider?  @relation("tunnel_dns_provider", fields: [dns_provider_id], references: [id], onDelete: SetNull)
  /// 显式 opt-in：缺省 false 表示**零外呼**，只返回建议值集（F5.3）
  dns_auto_resolve     Boolean       @default(false)
  /// 上次**已确认**的值集。"值集未变就不写"这条判据读它（F5.3），也是"多入口挂掉一个
  /// 入口无需写 DNS"能成立的依据
  dns_confirmed_values Json?
  /// 上次成功写入（且按被冻结的强度确认）的时刻；就绪性闸门按它算 proof age（F5.4）
  dns_synced_at        DateTime?
  /// 上次成功是**读回确认**（true）还是仅写入成功（false）。后者投影为
  /// `synced_unverified`——**不允许**把"写成功"说成"已切换"（Lead 裁决 D2）
  dns_verified         Boolean       @default(false)
  /// 上次失败的原因码（脱敏，不含凭据）
  dns_last_error       String?       @db.VarChar(120)
  /// V5-WP17.3：DNS 同步的**退避状态**。
  ///
  /// 契约 F7 要求"下一节拍按退避重试"，而"退避"是一个跨节拍的事实：没有这两列，
  /// 执行器每拍都会立刻重试同一次失败的写 —— 对端限流时那正是最坏的输入。
  /// 位置在 Forward 上（不是 provider 上）：同一个 provider 下不同域名的失败互相独立。
  dns_attempt_count    Int           @default(0)
  /// 下一次允许尝试的**最早**时刻。`NULL` = 没有待重试的失败。
  dns_next_attempt_at  DateTime?
  /// 实际入口节点。DIRECT / RELAY 都必须持久化；NULL 只允许存量未完成绑定行。
  /// NodeGroup 只是候选集合，运行时恢复/删除/对账不得再根据组重新猜节点。
  ingress_node_id Int?
  ingress_node    Node?      @relation("ingress_node", fields: [ingress_node_id], references: [id], onDelete: SetNull)
  /// V5-WP17.1（契约 D4 收口）：**首选入口节点**。
  ///
  /// 它之前根本不存在，而 `pickFailoverDestination` 又恒返回 `preferred_node_id = null` ⇒
  /// **自动回切永远不可能发生**（"写了功能但没有任何写入路径"的一类，与 `diag` 白名单陷阱同源）。
  /// 存储选在 Forward 上（契约 D4 的候选 A）：候选 B 要改 FROZEN 的 Route Profile 字段表，
  /// 候选 C 与 Lead 的"接到真实写入路径"直接矛盾。
  ///
  /// NULL = 没有偏好 ⇒ 今天的行为（不回切）。它与 `ingress_node_id` 是**两件事**：
  /// 后者是"现在归谁"，前者是"希望归谁"。混在一起会让一次回切看起来像配置被改写。
  preferred_ingress_node_id Int?
  preferred_ingress_node     Node? @relation("preferred_ingress_node", fields: [preferred_ingress_node_id], references: [id], onDelete: SetNull)
  /// V5-WP17.1：首选节点**连续**判定健康的次数，由 failover sweep 维护（健康 +1、否则归零）。
  ///
  /// 为什么必须是一列：策略要求"连续 N 次健康才允许回切"，而"连续"是**跨节拍**的事实 ——
  /// 从任何单次观测都推导不出来。缺了它，`failbackHealthyChecks` 恒为 0，回切一样永远不会发生。
  failback_healthy_checks Int @default(0)
  /// RELAY 实际出口节点；DIRECT 为 NULL（DEVELOPMENT.md §2.1）。
  /// 只保存 Node 而不只存 out_node_group：否则组内多 Agent 重启时无法判断
  /// 隧道真正属于谁。
  egress_node_id Int?
  egress_node    Node?      @relation("egress_node", fields: [egress_node_id], references: [id], onDelete: SetNull)
  /// RELAY 出口侧内部通信端口（节点间端口，**不是**用户可见端口）。
  /// 用户可见端口仍是 legacy `listen_port`。
  egress_port    Int?
  /// RELAY 指向的出口目标池
  egress_pool_id Int?
  egress_pool   EgressPool? @relation("egress_pool", fields: [egress_pool_id], references: [id], onDelete: SetNull)
  /// DIRECT 模式目标（由存量 forward_addresses[0] 幂等回填，见迁移）。
  /// RELAY 不使用本列（目标在 EgressTarget 上）。
  remote_host    String?    @db.VarChar(255)
  remote_port    Int?
  /// 期望状态：控制面想让隧道处于什么状态
  desired_status String?    @db.VarChar(20)
  /// 实际 apply 状态机（pending/applying/active/error/suspended）。
  /// 字符串而非枚举：DB 列先落地，枚举随 WP8 编排器一起收敛，避免现在加枚举
  /// 后 WP8 又要 ALTER 改它。
  apply_status   String?    @db.VarChar(20)
  /// 控制面期望版本；每次 desired/配置变更自增
  config_revision Int?
  /// 最近被 Agent ACK 确认的版本；`applied_revision < config_revision` = 待下发
  applied_revision Int?
  /// 结构化错误码 + 原文；失败时保留 Tunnel，前端展示原因并允许 Retry
  apply_error_code String?  @db.VarChar(64)
  apply_error      String?   @db.VarChar(500)
  last_applied_at  DateTime?

  port_leases NodePortLease[]

  // ── V4-WP1 增量字段（Forward Revision Foundation，迁移 20260927090000）──
  //
  // desired_revision_id 指向 forward_revision 表里**最新**的一条 snapshot，
  // 是「用户当前想跑什么」的权威指针。不加外键的两个理由：
  //   1. forward_revision.tunnel_id 已是 ON DELETE CASCADE 指向 tunnel，
  //      再加一条反向 FK 会形成循环级联路径，MySQL 深删时会走进锁竞争；
  //   2. 这是高频更新列（每次编辑都写），外键校验会给它加多余的 JOIN 成本。
  // 读取方必须校验 `desired_revision_id` 指向的行 revision == tunnel.config_revision；
  // 不匹配时按「从兼容投影列推算」降级并打日志，**绝不 fail-open 到旧配置**。
  //
  // 可空理由（expand-and-contract）：存量 Forward 从未有过 snapshot，
  // NULL = 「V4-WP1 之前创建，尚未被编辑过一次」。V4 代码读到 NULL 时按
  // 当前投影列合成基线（见 services/forward-revision.ts 的 baselineSnapshot）。
  desired_revision_id Int?
  /// V4-WP1：不可变 revision snapshot 历史（一对多，随 Tunnel 级联删除）。
  forward_revisions ForwardRevision[]
  /// V4-WP3：五阶段 rollout 记账历史（一对多，随 Tunnel 级联删除）。
  /// 只记「流程进度」，不复制 runtime 事实（见 model 注释）。
  forward_rollouts ForwardRollout[]

  // Node-first 后物理唯一性由 NodePortLease(node_id, port) 保证。
  // 同一 NodeGroup 内不同入口节点允许复用相同 listen_port。
  @@index([in_node_group_id, listen_port])
  @@index([workspace_id])
  /// V5.3 WP9：该 Forward 的归属租约（最多一行，见 model PlacementLease）。
  placement_lease PlacementLease?

  /// V5.4 WP12：2 跳 / 3 跳路由的**中间跳**节点（NULL = 单跳，V4 行为）。
  ///
  /// 为什么是一列而不是一张链路表：§9.1 明确推荐"先让 Forward revision snapshot 承载有序
  /// 路由事实，再根据真实重复需求决定是否独立持久化 Link"。一条线性路由最多 3 跳，其中
  /// hop 0 = ingress_node_id、hop N-1 = egress_node_id，因此**只多出一个中间跳**；为它开一张
  /// 表会在第一版就引入通用图结构，而那正是 §9.3 禁止的方向。
  ///
  /// 归属仍只有一个持有者（hop 0），中间跳是**资源**（见 §9 冻结契约第 7 条）。
  middle_node_id Int?
  middle_node    Node? @relation("middle_node", fields: [middle_node_id], references: [id], onDelete: SetNull)

  // ── V5-WP13.5B Route Profile provenance（DEVELOPMENT.md §9.4.2–§9.4.6）──
  //
  // 「这条 Forward 当前来自哪个 Route Profile / 哪个版本」。它是**指针**，不是第二份
  // 运行时真相：真正的执行路径永远读 forward_revision 的不可变快照，本列只回答
  // 「来源模板是谁」，供 impact analysis 使用（哪些 Forward 会被某次模板发布影响）。
  //
  // 为什么**不加外键**：模板在解除引用后可以被删除，而 Forward 的来源事实不能被
  // `ON DELETE SET NULL` 静默抹掉 —— 与 middle_node_id 的历史取向一致。「正在被引用的
  // 模板不允许删除」由服务层显式判定（409 profile_in_use），不靠级联静默发生。
  route_profile_id      Int?
  route_profile_version Int?

  // ── V5.5 WP15 产品级接线：远端出口腿的声明（migration 20261025000000）──
  //
  // `federated_egress_peer` = 这条 Forward 的**出口腿**由哪个 peer panel 承载
  // （存 peer_panel_id）。它不是第二份 desired：出站仍是本机 rollout 的计划与账本，
  // 这里只声明"那一跳不在本机"（契约 §3.4）。
  //
  // 为什么可空且不给默认值：NULL = 今天的行为（出口在本机），这是绝大多数行；
  // 空声明必须让所有既有路径逐字节不变（本轮的硬约束）。给了它就意味着
  // **本机不再有出口节点**（egress_node_id 为 NULL），本地端口/节点分配必须跳过
  // —— 远端资源只以 `federation_placement` 的不透明引用存在，绝不复制成本地 node /
  // node_port_lease 行（契约 §1、§7）。
  federated_egress_peer String? @db.VarChar(64)

  @@index([tunnel_mode])
  @@index([forward_protocol])
  @@index([ingress_node_id])
  @@index([egress_node_id])
  @@index([egress_pool_id])
  @@index([apply_status])
  @@map("tunnel")
}

/// V4-WP1 Forward Revision Snapshot（DEVELOPMENT.md §13.3.2）。
///
/// **Revision snapshot 不可原地修改**：`@@unique([tunnel_id, revision])` 保证
/// 同一 (tunnel, version) 只有一条，且没有任何代码路径 update/delete 已写入的
/// 行（删除只可能随 Tunnel 级联发生，见下方 tunnel 关系的 onDelete）。
///
/// 分层语义：本表**不是第二张用户业务真相表**。Forward 的产品身份仍在
/// `tunnel` 行（name / id / 归属 / 兼容投影列）；本表只承载「某个 revision
/// 时刻的完整 runtime 配置」，用于 §13.3.2 要求的可恢复性与 WP3 的
/// compensation（回退到 applied_revision 对应的 snapshot）。
///
/// 至少可恢复 §13.3.2 列出的运行态相关配置：
///   mode / ingress_node_id / egress_node_id /
///   requested listen_port（含自动分配语义：NULL）/ target_host / target_port
/// 另外保存 egress_pool_id + egress_port + targets 快照与 desired_status，
/// 让 RELAY 的恢复不需要反查当前池状态（池的目标可能在 revision 之后被改）。
///
/// 为什么节点/池列**不加外键**：snapshot 的历史性正是它的价值——节点被删后，
/// 「revision 12 当时跑在哪个节点上」这个事实不能被 `ON DELETE SET NULL`
/// 抹掉。悬空引用的校验是读取方（WP3 rollout 前必须确认节点仍存在）的职责，
/// 不是数据库该静默改写历史的地方。与 `node_port_lease.tunnel_id` 的无 FK
/// 先例同一取向（见该 model 注释）。
model ForwardRevision {
  id       Int @id @default(autoincrement())
  tunnel_id Int
  /// 随 Forward 共存亡：删 Tunnel 会删掉它的 revision 历史。
  /// 注意这与「删除 Forward 不得删除历史流量/审计」不冲突——那两类数据在
  /// `tunnel_traffic` / `audit_log`，不是本表。
  tunnel   Tunnel @relation(fields: [tunnel_id], references: [id], onDelete: Cascade)
  /// 单调递增，与 tunnel.config_revision 同值（同一事务内写入）。
  revision Int
  /// 保存这一刻的名称。允许与 tunnel.name 不同（可能只改了名）：
  /// snapshot 是 runtime 配置，改名不生成 snapshot（§13.3.2）。
  name String @db.VarChar(255)
  /// 保存这一刻的期望状态。`suspended` 编辑 = 存 desired 不启 runtime（§13.3.6）。
  desired_status String @db.VarChar(20)

  mode TunnelMode
  /// V5-WP0: protocol is part of the immutable runtime snapshot, orthogonal to mode.
  protocol String @default("tcp") @db.VarChar(16)
  ingress_node_id Int
  egress_node_id  Int?
  /// V5.4：该 revision 的中间跳放置事实。NULL = 单跳。
  /// 不加 FK：revision snapshot 是历史事实；节点删除不能改写过去的路由。
  middle_node_id  Int?
  /// 用户请求的监听端口；NULL = 「自动分配」。与创建 contract 同义：
  /// 编排器会在 apply 时落到 concrete port 并写回 tunnel.listen_port，
  /// 但 snapshot 保留的是**请求值**，才能还原「用户当时要自动还是指名」。
  listen_ip   String?
  listen_port Int?
  /// DIRECT 目标；RELAY 为 NULL（目标在 targets 快照里）。
  target_host String? @db.VarChar(255)
  target_port Int?
  /// RELAY 出口池 + 节点间内部端口；DIRECT 为 NULL。
  egress_pool_id Int?
  egress_port    Int?
  /// RELAY 保存时刻的 active EgressTarget 快照（[{host,port,weight,order_by}]）。
  /// 为什么必须冗余：§2.2 的硬规则是「目标修改只更新目标快照，不重建隧道」，
  /// 因此池内容可能在 revision 之后变化；只有 snapshot 能还原当时的完整配置。
  targets Json?
  /// 保存人（审计上下文）。无 FK：用户删除不得改写 runtime 历史。
  created_by_id Int?
  created_at    DateTime @default(now())

  // ── V5-WP13.5B Route Profile provenance（DEVELOPMENT.md §9.4.5）──
  //
  // 这一段回答「本次计划来自哪个 Route Profile / version」。它必须落在**不可变
  // 快照**里，才能满足 §9.4.5 的「applied runtime 不能依赖随后可变的模板内容」：
  // 模板之后被编辑/禁用/删除，都不改写这条 revision 的解释。
  //
  // 为什么**不**再存一份 resolved_hops：具体跳（含角色）就写在本行的
  // ingress_node_id / egress_node_id / middle_node_id 里，用 `buildRoutePlan`
  // 可以逐字还原成有序 hop 列表 —— 再存一列是第二份会漂移的真相。
  // 「这次 apply 解析出了什么」的申请级事实在 `route_profile_application`。
  /// 来源模板 id（无 FK：历史事实；模板删除不得改写「当时来自谁」）。
  route_profile_id      Int?
  /// 来源模板的版本（最近一次由该模板 apply 的版本）。
  route_profile_version Int?

  // ── V5.5 WP15：这一跳"在哪一侧"的不可变历史事实（migration 20261025000000）──
  //
  // 与 `ingress_node_id` / `egress_node_id` 同一层：它是某次 revision 的**放置事实**，
  // 因此必须冻结进快照 —— 之后用户/管理员改掉 tunnel 行的声明，都不改写"revision N 当时
  // 这条出口腿跑在谁身上"。NULL = 出口在本机（V4/V5 既有语义）。
  //
  // 不加外键、不复制远端 node 行：远端节点在 home panel 里**只有不透明引用**
  // （`federation_placement.peer_node_ref`），契约 §1/§7 明令禁止把它变成本地 node。
  federated_egress_peer String? @db.VarChar(64)

  @@unique([tunnel_id, revision])
  @@index([tunnel_id, created_at])
  @@map("forward_revision")
}

/// V4-WP3 Forward Rollout 记账（DEVELOPMENT.md §13.3.5 五阶段 / §13.3.2 可恢复性）。
///
/// **本表不是第二套真相**。它只回答「这一次 rollout 走到哪了」：
///   · `revision` / `base_revision` 是两个整数（与 tunnel 行既有的
///     `config_revision` / `applied_revision` 同值）；
///   · snapshot 内容一律读 `forward_revision`（WP1）；
///   · runtime 事实（端口、节点、目标）一律读 tunnel 行 + Agent 上报。
/// 把 runtime 事实复制进来只会得到三份会互相漂移的真相。
///
/// 为什么 `apply_status`（单值状态机）不够：它无法表达「这一跳到了哪个阶段、
/// 哪些资源已分配、补偿到哪一步」。§13.3.2 要求「只靠 DB revision + Agent
/// state report + NodePortLease 就能继续/补偿 rollout」，前提就是阶段进度
/// 本身已落库——这就是本表的存在理由。
///
/// **一条 tunnel 同一时刻至多一条未完成 rollout**：由服务层
/// `updateMany where phase in (active set)` 抢占；DB 层面刻意不加唯一键——
/// 允许历史多行并存，便于排障（哪一次 rollout 卡在哪一步要能查出来）。
model ForwardRollout {
  id Int @id @default(autoincrement())
  tunnel_id Int
  /// 随 Forward 共存亡：删 Tunnel 会删掉它的 rollout 记账历史。
  tunnel Tunnel @relation(fields: [tunnel_id], references: [id], onDelete: Cascade)
  /// 本次 rollout 的目标 revision（创建时刻 = tunnel.config_revision 的瞬时值）。
  revision Int
  /// 回退基线：启动本次 rollout 前的 applied_revision（compensation 目标）。
  /// NULL = 该 Forward 从未被成功 apply 过（首次编辑）。
  base_revision Int?
  /// validate|prepare|cutover|drain|cleanup|done|failed|compensating|degraded|waiting
  phase String @db.VarChar(20)
  /// §13.3.4 的分类（metadata_only|target_hot_swap|listener_replace|
  /// node_migration|mode_switch|noop）。WP1 `computeForwardImpact` 的投影，
  /// 随 rollout 行落库以便续跑与排障。
  /// 由迁移 20261009123000 追加（C4 实现晚于建表迁移，保持后者逐字不动）。
  strategy String? @db.VarChar(30)
  /// 阶段步骤记录（JSON：StepRecord[]，与 scheduler.SCHEDULER_STEPS 同构）。
  steps Json?
  /// 已分配/待回收资源句柄（leaseId / bindingId / egress 命令 id …）。
  prepared Json?
  /// 每个 CLEANUP 项的幂等键执行结果（重复执行走「已清」分支）。
  cleaned Json?
  /// 逐步的人类可读流水账（追加式 notes.push）。§13.3.5「哪一次 rollout 卡在哪一步
  /// 要能查出来」的载体；与 last_error 的区别：last_error 只记最终失败，notes 记全程。
  notes Json?
  /// CUTOVER 失败后是否已回退到 base_revision（§13.3.5 第三张表的判据）。
  /// 缺省 false 让存量行（迁移前的历史 rollout）语义安全：「未确认补偿」。
  compensated Boolean @default(false)
  /// compensation 失败的原因；非 NULL ⇒ phase 落到 degraded，交 Reconciler／
  /// 人工 Retry 修复（§13.3.5）。成功补偿时为 NULL。
  compensation_error String? @db.VarChar(500)
  /// 续跑/补偿的重试计数（观测用：attempt 暴涨 = 环境有问题，不是用户问题）。
  attempt Int @default(0)
  /// 当前唯一执行器。NULL = 无人持有；token 只用于 rollout 内部并发仲裁。
  executor_owner String? @db.VarChar(64)
  /// 执行租约到期时间。进程崩溃后其它 worker 只有在到期后才能接管。
  executor_lease_until DateTime?
  last_error_code String? @db.VarChar(64)
  last_error String? @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([tunnel_id, revision])
  @@index([phase])
  @@index([executor_lease_until])
  @@map("forward_rollout")
}

model TunnelChain {
  id            Int       @id @default(autoincrement())
  tunnel_id     Int
  tunnel        Tunnel    @relation(fields: [tunnel_id], references: [id])
  node_type     NodeType
  node_group_id Int
  node_group    NodeGroup @relation(fields: [node_group_id], references: [id])

  @@map("tunnel_chain")
}

/// task-43 —— **按 Forward 自定义的入口成员次序**。
///
/// 行为参照：ForwardX（AGPL-3.0-only）——多入口/转发组的成员表（`forward_group_members`：
/// 成员 + `priority` + `isEnabled`）；代码为本项目改写，未复制其实现。
///
/// ── 为什么需要它（而不是把次序塞进节点列）──
/// 次序是**按这条转发**的意图：同一台节点可以在 A 转发里排第 1、在 B 转发里排第 3。
/// 节点组是多条转发**共享**的资源，把次序写进 `Node.order_by` 会让共用该组的其它转发
/// 一起变形，且编辑权限被迫提到 `node:manage`。所以次序必须落在"按转发"的行上。
///
/// ── 这张表**只有意图**，没有事实 ──
/// 刻意**不**带任何健康/延迟/失败时刻列（ForwardX 的成员表有 `healthStatus` 等）：连接、
/// 准入、探测结果的事实来源是节点上报与既有投影（`deriveConnection` / `nodeAdmission` /
/// 观测档案），在这张表里再存一份就是**第二份真相**，两边一旦漂移就会出现"界面说它健康、
/// 平台却切走了"。
///
/// ── 兼容性（expand-only，不回填）──
/// **没有行 = 今天的行为**（合格候选按 `node_id` 升序）。因此本表上线不需要回填任何数据，
/// 也不会改变任何既有转发的迁移结果；只有用户显式保存过一次次序之后，表里才有行。
///
/// 级联：Forward 被删或节点被删时，意图行随之消失（它描述的是"这两者之间的关系"，
/// 关系的一端不存在了，行就没有意义）。**没有任何账本语义**，所以级联删除是安全的。
model ForwardIngressMember {
  id         Int      @id @default(autoincrement())
  tunnel_id  Int
  tunnel     Tunnel   @relation(fields: [tunnel_id], references: [id], onDelete: Cascade)
  node_id    Int
  node       Node     @relation(fields: [node_id], references: [id], onDelete: Cascade)
  /// 0 起升序 = 优先级；同一 tunnel 内唯一（由写入路径按数组下标归一化后全量替换）。
  priority   Int
  /// false = 这次次序里**显式停用**该成员（它仍是组内合法入口，但不再被选来接管）。
  is_enabled Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tunnel_id, node_id])
  @@index([tunnel_id, priority])
  @@map("forward_ingress_member")
}

/// v3 出口目标池（WP1，DEVELOPMENT.md §2.2）。
///
/// 层级：`Node (role=egress|both) → EgressPool → EgressTarget[]`。
/// 每个出口节点自动拥有一个 `default` 池（初期 UI 可完全隐藏 Pool 概念），
/// RELAY 隧道通过 `tunnel.egress_pool_id` 指向池。
///
/// 关键语义：**目标修改只更新目标快照，不重建监听、也不重建隧道**。因此本表
/// 不带任何 revision 字段——版本由 `Tunnel.config_revision` 驱动，池的变更
/// 触发指向它的隧道升 revision，而不是自己计数。
///
/// workspace 归属：池归节点所属 workspace（Node → node_group → workspace），
/// 不冗余 workspace_id 列。跨租户校验沿 `pool.node.node_group.workspace_id`
/// 单向上查，避免两份可能漂移的归属真相。
model EgressPool {
  id      Int     @id @default(autoincrement())
  node_id Int
  node    Node    @relation(fields: [node_id], references: [id], onDelete: Cascade)
  /// 每节点内唯一（含自动创建的 `default`）
  name    String  @db.VarChar(120)
  /// 池内目标选择策略；NULL = 回落到 node.lb_strategy
  lb_strategy LBStrategy?
  /// inactive = 停用整池：指向它的 RELAY 隧道应进入可解释的 error/suspended，
  /// 而不是继续下发空目标快照
  status Status @default(active)
  /// 池内至少保留一个 active 且 weight>0 的目标，否则拒绝应用新目标快照
  /// （DEVELOPMENT.md §2.2 硬规则）。该不变式由分配/应用服务保证，不在 DB 层。
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  targets EgressTarget[]
  tunnels Tunnel[]     @relation("egress_pool")

  @@unique([node_id, name])
  @@index([node_id, status])
  @@map("egress_pool")
}

/// v3 出口目标（EgressPool 成员）。
///
/// 与原版 `tunnel.forward_addresses`（JSON，落在隧道上）的关系：DIRECT 继续用
/// 旧列，RELAY 用本表。两条路径并存是 expand-and-contract 的必然，不是重复设计。
model EgressTarget {
  id      Int        @id @default(autoincrement())
  pool_id Int
  pool    EgressPool @relation(fields: [pool_id], references: [id], onDelete: Cascade)
  /// 目标地址（IP 或域名）。不存 host:port 组合串：端口另有独立列，
  /// 组合串会让「按端口查询/校验退化为字符串解析」。
  host   String @db.VarChar(255)
  port   Int
  /// 权重；加权策略下生效。创建后必须存在至少一个 weight>0 的目标。
  weight Int    @default(1)
  /// 排序/轮询次序（同原版 order_by 语义）
  order_by Float @default(1000)
  remark String? @db.VarChar(255)
  status Status @default(active)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([pool_id, status])
  @@map("egress_target")
}

/// v3 端口租约（WP1，DEVELOPMENT.md §5.1）。
///
/// **`UNIQUE(node_id, port)` 是端口所有权的最终一致性真相源**；Redis NX 只做
/// 快速并发抢占/短事务协调，不做长期真相。方向（lease_type）只是元数据，
/// 以免 BOTH 节点用同一端口同时双绑 ingress/egress。
///
/// 不设外键到 tunnel：租约必须先于隧道可撤销存在（预分配、补偿释放），
/// 且隧道被删时租约应先释放而非级联——级联会让「释放」这件事静默发生，
/// 无法在审计里区分「主动释放」与「随隧道消失」。
model NodePortLease {
  id      Int  @id @default(autoincrement())
  node_id Int
  node    Node @relation(fields: [node_id], references: [id], onDelete: Cascade)
  /// 占用方隧道；NULL = 预分配/孤儿租约（可通过 reconcile 回收）。
  /// 无外键约束（见 model 注释）：隧道删除时租约应由编排器显式释放。
  tunnel_id  Int?
  tunnel    Tunnel? @relation(fields: [tunnel_id], references: [id], onDelete: SetNull)
  /// 端口号；与 node_id 共同构成物理唯一性
  port       Int
  lease_type LeaseType
  /// active = 占用中；released = 已释放（保留行供对账，不物理删除）
  status     String  @db.VarChar(20)
  /// 租约过期时间；NULL = 不自动过期。过期后由 reconciler 回收而非即时释放，
  /// 避免控制面与 Agent 之间的瞬时不一致误杀活跃连接。
  expires_at DateTime?
  created_at DateTime  @default(now())

  @@unique([node_id, port])
  @@index([tunnel_id])
  @@index([node_id, status])
  @@map("node_port_lease")
}

model User {
  id                       Int                @id @default(autoincrement())
  super_admin              Boolean            @default(false)
  email                    String             @unique
  balance                  Float              @default(0)
  commission_balance       Float              @default(0)
  tg_id                    String?
  uid                      String?
  note                     String?
  tunnels                  Tunnel[]
  parent_id                Int?
  parent                   User?              @relation("UserReferral", fields: [parent_id], references: [id])
  children                 User[]             @relation("UserReferral")
  referral_commission_rate Float?
  referral_first_only      Boolean?
  auto_renew               Boolean            @default(false)
  /// SEC-02（legacy 明文列，保留仅为惰性迁移）。
  ///
  /// 新签发的凭据只写 `api_key_hash`（sha256）。明文列在两处被清空：
  ///  1. 惰性迁移：认证命中存量明文行时同事务写哈希并置本列为 null；
  ///  2. 轮换：rotateKey 覆盖哈希列并置本列为 null。
  /// 因此本列必须可空 + 去掉 `@default(uuid())`（默认值会让 Prisma 的
  /// `db.user.create()` 永不显式写 null，惰性迁移与 seed 都退化成明文落库）。
  /// 唯一索引保留：NULL 可重复，不影响「迁移后所有明文行均为 null」的终态。
  api_key                  String?            @unique
  /// SEC-02：subscription_key 明文列，迁移策略同 api_key（可空、无默认值）。
  subscription_key         String?            @unique
  /// SEC-02：api_key 的 sha256 hex（64 字符）。新签发凭据只落哈希；明文列
  /// （api_key）保留仅用于惰性迁移——认证命中明文行时同事务写入哈希并清空明文。
  api_key_hash             String?            @unique @db.Char(64)
  /// SEC-02：subscription_key 的 sha256 hex；迁移策略同 api_key_hash。
  subscription_key_hash    String?            @unique @db.Char(64)
  notify_subscriptions     Json?
  admin_notify_subscriptions Json?
  node_groups              NodeGroup[]
  personal_workspace       Workspace?       @relation("PersonalWorkspace")
  workspace_memberships    WorkspaceMember[]
  node_group_grants        NodeGroupGrant[]
  created_custom_roles     WorkspaceCustomRole[] @relation("WorkspaceCustomRoleCreator")
  status                   Status             @default(active)
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt
  /// TEN-03：邮箱验证时间。NULL = 未验证（老用户与 0.1 阶段软约束兼容）。
  email_verified_at        DateTime?
  email_verifications      EmailVerification[]
  orders                   PlanOrder[]
  topups                   TopupOrder[]
  user_plan                UserPlan?
  balance_logs             BalanceLog[]
  commission_logs          CommissionLog[]
  tickets                  Ticket[]
  ticket_replies           TicketReply[]
  withdraw_requests        WithdrawRequest[]
  dns_providers            DNSProvider[]
  admin_roles              AdminRole[]
  credential               UserCredential?

  @@map("user")
}

model AdminRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  permissions Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  users       User[]

  @@map("admin_role")
}

/// V5-WP20-2（契约 `docs/v5-wp20-subscription-billing-runtime-contract.md` §3.3/§3.5.2）：
/// **legacy 展示视图，冻结**。不要把它接回任何判定路径。
///
/// 三条冻结理由（契约 §4.0 Lead 裁决）：
///  1. 判定链全部按 **workspace**（`WorkspacePolicyAssignment` → `composeEffectivePolicy`），
///     而本表是**用户级单例**（`user_id @unique`），在 team workspace 下无法表达
///     「一个租户一份套餐、多成员共享额度」；套餐归属的唯一真相是
///     `PlanSubscription`（`workspace_id @unique`）。
///  2. `traffic_used` **禁止回写**：流量真相是「已归档事实（`tunnel_traffic`）的窗口求和」，
///     回写本列会产生第二份用量真相。前端要展示已用流量请读 `GET /api/me/capabilities`。
///  3. `traffic` / `max_tunnels` / `whitelist_ips` 同理是**历史快照**，不得当作额度判定输入
///     （额度唯一真相是显式发放）。
///
/// 本表仍由 `personal` workspace 的购买路径**双写**（保持 dashboard/admin 展示不破），
/// 双写同事务，且 `PlanSubscription` 是真相、本表是投影。
model UserPlan {
  id            Int       @id @default(autoincrement())
  user_id       Int       @unique
  user          User      @relation(fields: [user_id], references: [id])
  traffic       Float?
  traffic_used  Float     @default(0)
  max_tunnels   Int?
  whitelist_ips Json?
  expired_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  plan_id       Int
  plan          Plan      @relation(fields: [plan_id], references: [id])

  @@map("user_plan")
}

enum BillingCycle {
  month
  quarter
  half_year
  year
  lifetime
}

model Plan {
  id                          Int          @id @default(autoincrement())
  name                        String       @db.VarChar(255)
  description                 String?
  original_price              Float?
  price                       Float
  max_tunnels                 Int?
  traffic                     Int?
  ip_limit                    Int?
  client_limit                Int?
  bandwidth_limit             Int?
  whitelist_limit             Int?
  allow_custom_in_node_group  Boolean
  allow_custom_out_node_group Boolean
  all_in_node_groups          Boolean
  all_out_node_groups         Boolean
  setup_fee                   Float?
  billing_cycle               BillingCycle @default(month)
  status                      Status       @default(active)
  renewable                   Boolean      @default(true)
  stock                       Int?
  order_by                    Float        @default(1000)
  /// V5-WP20-4（契约 §3.5.3）：套餐 → 能力策略的**显式**绑定，购买时据此发 `purchase` 发放。
  ///
  /// 为什么必须显式、不能推导：`composeEffectivePolicy` 只认「哪一条发放存在」（F1/F5），
  /// 从 `Plan.max_tunnels`/`traffic` 反推一条策略会造出第二份额度真相（§3.5.3 明确不做③）。
  ///
  /// **NULL 的语义**（不是错误）：该套餐没有绑定策略。历史套餐与尚未配置的套餐都是 NULL，
  /// 此时购买路径**不发放** `purchase` 发放，也不因此拒绝购买 —— 扣款、订单、订阅照常，
  /// 用户的准入继续由既有的 `system_default` 发放决定（= 今天的行为，逐字节不变）。
  /// 反例：① 若 NULL 就拒绝购买，存量商品会当场不可售；② 若 NULL 就随便挑一条模板发放，
  /// 就是上面禁止的隐式推导（用户会拿到一条他没买过的策略）。
  policy_id                   Int?
  policy                      CapabilityPolicy? @relation(fields: [policy_id], references: [id], onDelete: SetNull)
  created_at                  DateTime     @default(now())
  updated_at                  DateTime     @updatedAt

  node_groups PlanNodeGroup[]
  orders      PlanOrder[]
  user_plans  UserPlan[]
  subscriptions PlanSubscription[]

  @@map("plan")
}

model PlanNodeGroup {
  id            Int       @id @default(autoincrement())
  plan_id       Int
  node_group_id Int
  node_group    NodeGroup @relation(fields: [node_group_id], references: [id])
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  plan Plan @relation(fields: [plan_id], references: [id])

  @@map("plan_node_group")
}

model PlanOrder {
  id         Int         @id @default(autoincrement())
  user_id    Int
  user       User        @relation(fields: [user_id], references: [id])
  plan_id    Int
  plan       Plan        @relation(fields: [plan_id], references: [id])
  price      Float
  balance    Float
  coupon_id  Int?
  coupon     PlanCoupon? @relation(fields: [coupon_id], references: [id])
  /// V5-WP20-2（契约 §3.5.4）：这笔钱**买给哪个租户**。`user_id` 保持「谁点的购买谁付款」，
  /// 本列是归属维度。**历史行 NULL 是合法历史，不猜**（契约 R5）——所以可空、无默认值、
  /// 无回填；新行必填由 WP20-4 的应用层保证。
  /// 删除语义：`SetNull`（Prisma 对可空关系的默认）——既有删用户流程会先 `workspace.deleteMany`
  /// 再删 `planOrder`（`routes/admin-extended.ts:424` 起），`Restrict` 会让删用户直接失败。
  workspace_id Int?
  workspace  Workspace?  @relation(fields: [workspace_id], references: [id], onDelete: SetNull)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  settlements SubscriptionPeriodSettlement[]

  @@index([workspace_id])
  @@map("plan_order")
}

/// V5-WP20-2（契约 §3.5.2）：**订阅归属的唯一真相** —— 套餐属于 **Workspace**，不属于 user。
///
/// 为什么不继续用 `UserPlan`：判定链（额度、资源计数、`sumWorkspaceTraffic`）全部按 workspace，
/// 而 `UserPlan.user_id @unique` 是用户级单例，无法表达 team workspace 下
/// 「一个租户一份套餐、多成员共享额度」。本表 `workspace_id @unique` 直接表达该形状。
///
/// 快照字段**只含商务口径**（`plan_name` / `billing_cycle` / `price`）：套餐改价改名后，
/// 历史订阅仍要能对账。**刻意不抄 `traffic` / `max_tunnels` 等额度数字** —— 额度判定的唯一
/// 真相是显式发放（`WorkspacePolicyAssignment` → `composeEffectivePolicy`），把额度抄进订阅行
/// 会制造第二份额度真相并诱导读方做「套餐 → 策略」的隐式推导（契约 §3.5.3、§8.3、F5/F6）。
model PlanSubscription {
  id            Int           @id @default(autoincrement())
  /// 一个 workspace 至多一份有效订阅（契约 §3.5.2 的目标形状）。
  workspace_id  Int           @unique
  /// 删除语义 = `Cascade`：既有删用户流程会删掉 `personal` workspace
  /// （`routes/admin-extended.ts:424` 的 `workspace.deleteMany`），`Restrict` 会让「删用户」
  /// 直接失败；订阅随租户消失是该流程的既有意图。
  workspace     Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  plan_id       Int
  plan          Plan          @relation(fields: [plan_id], references: [id])
  started_at    DateTime
  /// **可空**：`BillingCycle` 含 `lifetime`（F25），终身订阅没有到期点。若设 NOT NULL，
  /// 终身套餐会被迫写一个魔法日期（如 9999-12-31），那就是第二个真相 + 边界 bug。
  expires_at    DateTime?
  /// 自动续费 fail-closed 默认关闭（契约 §3.5.3）：结算任务只记账、只降级，绝不默认扣款续期。
  auto_renew    Boolean       @default(false)
  /// 订阅来源。**VARCHAR 而不是新枚举**：加值不该要求一次 schema 变更（联邦同取向，
  /// 见 `20261022000000_v5_wp14_federation_identity` 的注释）；合法值由应用层校验，
  /// 当前集合 `{purchase, admin_grant}`，默认 `purchase`。
  source        String        @db.VarChar(32) @default("purchase")
  /// 购买当时的套餐名快照（套餐改名后历史订阅仍可对账）。
  plan_name     String        @db.VarChar(255)
  /// 购买当时的计费周期快照。
  billing_cycle BillingCycle
  /// 购买当时的价格快照（`PlanOrder.price` 是实付，本列是当时标价，两者不同不矛盾）。
  price         Float
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  settlements SubscriptionPeriodSettlement[]

  @@index([plan_id])
  /// 到期扫描（`started_at <= now < expires_at`，契约 §8.1：订阅「有效」是时间比较，不是状态列）。
  @@index([expires_at])
  @@map("plan_subscription")
}

/// V5-WP20-2（契约 §3.1.4）：**周期结算账本**，「每个周期只结算一次」的幂等闸门。
///
/// 幂等不是「再查一遍」，而是**先占位后执行**（先例 `federation/usage.ts:575` 的唯一索引取向）：
///   ① `create` 占位（唯一键 `(plan_subscription_id, period_key)` 命中 `P2002` ⇒ 本轮跳过）
///   → ② 扣款/发放 → ③ 置 `settled`。崩溃在 ① 与 ② 之间的 `pending` 由下一轮**接管续跑**。
/// 因此本表不得有应用层删除路径；「重置展示」与「篡改账本」必须分离（契约 §2 吸收语义）。
model SubscriptionPeriodSettlement {
  id                   Int              @id @default(autoincrement())
  plan_subscription_id Int
  plan_subscription    PlanSubscription @relation(fields: [plan_subscription_id], references: [id], onDelete: Cascade)
  /// 周期标记：Asia/Shanghai 下的 `YYYY-MM`（月结）或 `YYYY-MM-DD`（日结）。
  /// **形状由 WP20-2 冻结**（WP20-1 刻意不先冻一个没有消费者的格式）。
  period_key           String           @db.VarChar(16)
  /// `pending` | `settled` | `failed`。VARCHAR + 应用层校验，不用新枚举（DoD 第 7 条：
  /// `enum .*Status` 数量不得增加；状态集合还会长，枚举加值会让旧二进制读未知值即失败）。
  state                String           @db.VarChar(16) @default("pending")
  /// 接管续跑的尝试计数（超时由 `SystemConfig` 提供，默认 10 分钟，不硬编码 —— 契约 O4）。
  attempts             Int              @default(0)
  /// 本次结算产生的订单（未扣款的周期为 NULL）。账本行删掉时置 NULL，不连带抹掉结算占位。
  order_id             Int?
  order                PlanOrder?       @relation(fields: [order_id], references: [id], onDelete: SetNull)
  /// 失败原因（给人看；判定与重试不依赖它的内容）。
  error                String?          @db.Text
  /// 本次结算**开始**时间：接管判定的基准（`state="pending"` 且 `started_at` 早于超时 ⇒ 可接管）。
  started_at           DateTime         @default(now())
  settled_at           DateTime?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  /// 幂等闸门：同一订阅的同一周期只能有一行。
  @@unique([plan_subscription_id, period_key])
  /// 接管续跑扫描：按「状态 + 开始时间」捞超时的 `pending`。
  @@index([state, started_at])
  @@map("subscription_period_settlement")
}

