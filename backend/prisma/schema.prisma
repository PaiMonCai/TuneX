enum DNSRecordType {
  A
  AAAA
  CNAME
}

/// V5-WP17（契约 F4）：两种前门形态。
///
/// - `multi_entry`（首选）：记录集 = 当前**可用入口集合**（通常 ≥2）。单个入口挂掉
///   **不需要写 DNS**，客户端靠记录集里的其它地址自愈 —— 这一支把"DNS 写延迟"从
///   可用性关键路径上摘掉；
/// - `single_active`：记录集 = 当前 owner 的 `connect_ip`，每次归属迁移都要写。
enum DNSMode {
  multi_entry
  single_active
}

model DNSProvider {
  id                Int              @id @default(autoincrement())
  name              String           @db.VarChar(255)
  type              DNSProviderType
  /// 凭据。V5-WP17（契约 F6）：**必须**是 `services/federation/seal.ts` 的
  /// `sealSecret` 输出（AES-256-GCM + HKDF(AUTH_SECRET)），**禁止明文 JSON**。
  /// 列的形状不变（仍是 JSON），约定的是内容形态——这样不需要新表，也不会
  /// 与既有的密钥体系并列出第二套。
  config            Json
  /// 创建者。**不是**作用域：历史行只有它，读权限看下面的 workspace_id。
  user_id           Int
  user              User             @relation(fields: [user_id], references: [id])
  /// V5-WP17（契约 F6）：凭据的**作用域**。`user_id` 是错的粒度——凭据属于资源域，
  /// 不属于个人。
  ///
  /// - 非 NULL = 租户凭据，只有该 workspace 能读写；
  /// - NULL   = 遗留全局行 / 平台级凭据。**非平台管理员读取即 fail-closed**
  ///   （历史行按 F6 需要一次显式迁移策略，不允许"NULL 就等于人人可用"）。
  workspace_id      Int?
  workspace         Workspace?       @relation("workspace_dns_providers", fields: [workspace_id], references: [id], onDelete: SetNull)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  in_node_group_dns InNodeGroupDNS[]
  /// V5-WP17：使用这个 provider 作为前门的 Forward。删除 provider 时 Forward 被
  /// SetNull（前门回落到"未绑定"），而不是级联删掉 Forward——丢掉一条转发是
  /// 不可逆的事故，而丢一个 DNS 绑定是"重新配一次"。
  tunnels           Tunnel[]         @relation("tunnel_dns_provider")

  @@index([workspace_id])
  @@map("dns_provider")
}

/// 审计事件里的操作者类型。
enum AuditActorType {
  /// 普通登录用户
  user
  /// 平台超级管理员
  super_admin
  /// 具备后台角色的管理员
  admin
  /// 系统/后台任务（worker、cron）
  system
  /// 未认证请求（登录/注册/支付回调等）
  anonymous
}

/// 操作审计日志（append-only）。
///
/// 写入由 `src/middlewares/audit.ts` 在响应后 fire-and-forget 完成；
/// 记录「谁（actor）在什么上下文（ip/ua）对什么资源（resource/id）做了什么
/// （action＝`METHOD 归一化路径`）以及结果（status）」。
/// 不落请求体：避免把密码/卡片等敏感字段带进日志。
model AuditLog {
  id          Int            @id @default(autoincrement())
  actor_type  AuditActorType @default(anonymous)
  actor_id    Int?
  actor_email String?        @db.VarChar(255)
  /// 形如 `POST /api/admin/users/:id`（数字段归一化为 :id）
  action      String         @db.VarChar(191)
  /// 资源名，如 `admin/users`、`tunnels`、`auth/login`
  resource    String         @db.VarChar(64)
  /// 资源主键（路径中首个数字段），无则为 null
  resource_id String?        @db.VarChar(64)
  method      String         @db.VarChar(10)
  path        String         @db.VarChar(255)
  status      Int
  ip          String?        @db.VarChar(64)
  user_agent  String?        @db.VarChar(255)
  /// 附加结构化信息（默认 null；不要让调用方写入敏感字段）
  metadata    Json?
  created_at  DateTime       @default(now())

  @@index([actor_id])
  @@index([resource, resource_id])
  @@index([created_at])
  @@map("audit_log")
}

/// 密码凭证表。
/// 原版 `user` 表无密码列（Stack Auth 托管），本实现自签本地 JWT 需本地凭证，
/// 故拆表存放，`user` 表列结构保持与原版 100% 一致（零列改动）。
model UserCredential {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  password   String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("user_credential")
}

/// TEN-03：邮箱验证 / 密码重置共用的一次性令牌表。
///
/// 设计（对齐 workspace_invite 的既有安全取向）：
///  · **只存哈希**：`token_hash` 为 sha256(token) 的 hex；明文 token 只在邮件链接里出现一次。
///  · **单次使用**：`used_at` 置位即失效；重复使用返回同一「无效或已使用」响应，不区分状态。
///  · **过期**：`expires_at` 到期即失效；验证邮件 24h，密码重置 1h。
///  · **同邮箱发新 token 时旧的立即作废**（仍是「一次一封有效信」的语义）。
///  · purpose 区分用途，杜绝「用验证链接改密码」之类的跨用途重放。
model EmailVerification {
  id         Int       @id @default(autoincrement())
  user_id    Int
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  email      String    @db.VarChar(191)
  purpose    String    @db.VarChar(32) // email_verify | password_reset
  token_hash String    @unique @db.Char(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, purpose])
  @@index([email, purpose])
  @@index([expires_at])
  @@map("email_verification")
}

/// WP7 — Node state report（DEVELOPMENT.md §7.10「state report + reconnect snapshot」）。
///
/// Agent 通过 `POST /api/internal/node/state`（Bearer 节点凭据）上报：
/// 版本 / 角色 / 端口占用 / 隧道列表 / 出口池快照。**每节点一行**
/// （`@@unique([node_id])`），语义是「这个节点当前的状态快照」，不是时序表 ——
/// 时序是流量/指标的事（traffic-archive），状态的对账由 WP9 reconciler 做。
///
/// 为什么快照进 DB 而不是只进 Redis：
///   · 重连恢复（reconnect snapshot）要求面板在 Agent 断线重连后立刻知道
///     「它上次报的是什么」——Redis 键有 TTL，重启即丢，DB 才是还活着的真相；
///   · WP9 reconciler 对比 desired state / applied state 需要一份可查询的
///     agent 侧事实（`reported_revision` vs `tunnel.config_revision`）；
///   · 面板「runtime/state query」（WP10）需要节点维度查询，不是扫 Redis pattern。
///
/// 只写快照不写凭据：本表**没有**任何凭据字段，token 不落库的更广义版本是
/// 「凭据相关产物一律不进新表」。哈希在 `node.node_credential_hash`。
///
/// `tunnels` / `egress_pools` / `used_ports` 是 JSON 而非关联表：这是**对端
/// 报来的原文快照**，不是面板自己的模型；做成外键表会让「Agent 报了一个面板
/// 没下发的隧道」这种冲突无处安放，而 JSON 快照天然容纳这种偏差并由 reconciler
/// 判定。形状见 services/node-state.ts 的 StateReport 类型。

/// V5.2 WP5 —— 目标观测投影（Observation 是事实，不是 desired）
///
/// 契约见 DEVELOPMENT.md §7：观测按 **(观测节点, target) 二维** 存储，同一
/// host:port 被两个节点观测是**两条不同的事实**（视角不同），所以唯一键是
/// (node_id, target_key) 而不是 target_key。
///
/// 刻意**不**做的事：
///   · 不写 EgressTarget 的 desired 字段 —— desired 表达"用户要什么"，
///     观测表达"我们看到了什么"，互相改写会让"谁改了目标"无法回答；
///   · 不存 observation_age —— age 是 `now - observed_at`，取的时候算；
///     存下来的 age 在写入那一刻就已经是错的；
///   · 不存历史。当前只保留每个 (node, target) 的最新一条投影；是否需要历史
///     记录由数据保留需求决定（契约 §7 的开放决策）。
///
/// `success_rate` 由**观测方**计算并上报（契约第 6 条）：面板不重算，
/// 否则同一个事实会有两个可能不一致的算法。

/// V5.3 WP9 —— 归属租约（fencing）。这是防 split brain 的**唯一**机制。
///
/// 危险场景（§8.2）：面板以为 A 掉线 → 让 B 接管 → A 其实只是被分区，仍在监听。
/// 于是同一个 Forward 有两个主人。防它的不是"更准的心跳"，而是**所有权世代（epoch）**：
/// 只有持有当前 epoch 的节点才允许服务；被降级的节点在收到更高 epoch 时拒绝继续。
///
/// 关键字段与为什么存在：
///   · `epoch` 单调递增，"最后写入者获胜"被明确禁止（§8）；任何归属变更都是 epoch+1；
///   · `lease_expires_at` 到期即**停**（fail-safe）："可能还有另一个主人"比"短暂中断"更危险；
///   · `revision` 把租约钉在某个配置版本上，避免"新主人用旧配置"或反之；
///   · 每个 tunnel 只有一行（`@unique`），因此不存在"两条租约都自称有效"的表示法。
model PlacementLease {
  id         Int      @id @default(autoincrement())
  tunnel_id  Int      @unique
  tunnel     Tunnel   @relation(fields: [tunnel_id], references: [id], onDelete: Cascade)
  /// 当前承载该 Forward 的节点。
  owner_node_id Int
  owner_node Node    @relation(fields: [owner_node_id], references: [id], onDelete: Cascade)
  /// 所有权世代：单调递增，绝不回退（回退会被 Agent 侧拒绝）。
  epoch      Int      @default(0)
  /// 租约到期时刻（DB 时钟）。到期未续 = 不允许继续服务。
  lease_expires_at DateTime
  /// 该租约对应的配置 revision。
  revision   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([owner_node_id, lease_expires_at])
  @@map("placement_lease")
}

model TargetObservation {
  id         Int    @id @default(autoincrement())
  node_id    Int
  node       Node   @relation(fields: [node_id], references: [id], onDelete: Cascade)

  /// 归一化后的目标身份（host 小写去尾点 + :port），同一目标只有一个身份。
  target_key String @db.VarChar(288)
  host       String @db.VarChar(255)
  port       Int

  /// 上次探测是否连上（观测事实，不是期望状态）。
  reachable Boolean
  /// 连接耗时（毫秒）；不可达为 NULL —— 不写 0，0 是"瞬间可达"，不是"不知道"。
  latency_ms Int?
  /// 自上次状态翻转起的连续成功/失败次数（迟滞判决的输入）。
  consecutive_success Int @default(0)
  consecutive_failure Int @default(0)
  /// 最近 N 次探测的成功比例，0..1；由观测方计算。
  success_rate Float @default(0)

  /// 观测时刻（Agent 时钟）与面板收到该上报的时刻（DB 时钟）。
  /// 两者都留着：age 用前者算，而"这份观测有多旧"在跨节点时钟偏斜时
  /// 需要一个不依赖 Agent 时钟的参照。
  observed_at DateTime
  reported_at DateTime @default(now())
  /// 谁说的：观测节点 + 探测种类（契约第 6 条的 observation_source）。
  observation_source String @db.VarChar(64)

  updated_at DateTime @updatedAt

  @@unique([node_id, target_key])
  @@index([target_key])
  @@map("target_observation")
}

/// V5-WP19-B —— 目标观测的**原始样本档案**（契约 §4.0 Lead 裁决 O1+O4）。
///
/// 与 `target_observation` **投影并列，不是它的历史行**：投影回答"现在怎么样"
/// （每 (节点,目标) 一行、upsert、还被 `deleteMany(notIn: seen)` 收窄），档案回答
/// "过去怎么样"（只追加、永不被投影读取、永不作为健康判定输入）。
///
/// 「只 INSERT」不是修辞：本表没有 upsert 路径，也没有 updated_at —— 一行样本一旦
/// 写下就只有一个含义（`tunnels[].diag` 那类"重建成另一个形状"的事在这里不允许发生）。
/// 保留期 24h（可配置），清理按 `observed_at` 索引删，与写入节拍同源。
///
/// 为什么用 BigInt 主键：一次状态上报为每个目标追加一行，节拍 ~30s，
/// 单个目标就是 2880 行/天；Int 主键（21 亿）在千级节点 × 数十目标的规模下
/// 一年多就会溢出。主键**不出现在任何读路径**（避免 BigInt → JSON 的坑）。
model TargetLatencySample {
  id      BigInt @id @default(autoincrement())
  node_id Int
  node    Node   @relation(fields: [node_id], references: [id], onDelete: Cascade)

  /// 与投影同一套身份（`node-state.ts:targetKeyOf`）：两侧必须同步，单改一侧 =
  /// 历史与投影对不上同一个目标。
  target_key String @db.VarChar(288)
  host       String @db.VarChar(255)
  port       Int

  /// 该次观测的事实。`latency_ms` 为 NULL = 这次没有测到延迟（不可达）；
  /// **不是 0**（0 是"瞬间可达"）。档案里也保持这个区分。
  reachable  Boolean
  latency_ms Int?
  success_rate Float @default(0)
  /// 谁说的（观测节点角色 + 探测种类）。入桶键的一部分：不同口径的延迟**不可平均在一起**。
  observation_source String @db.VarChar(64)

  /// `observed_at` = Agent 观测时刻（序列的横轴）；`reported_at` = 面板收到该上报的时刻。
  observed_at DateTime
  reported_at DateTime @default(now())

  /// 清理：`observed_at < cutoff` 按索引删（G19.8 的"按索引清理"）。
  @@index([observed_at])
  /// 读路径：一条 (节点, 目标) 序列的时间窗口。
  @@index([node_id, target_key, observed_at])
  @@map("target_latency_sample")
}

/// V5-WP19-B —— 小时桶档案（保留期 30d）。原始样本过期后，这是"过去抖不抖"的唯一答案。
///
/// 桶由**已结束的整点小时**的原始样本聚合而来（`latency-history.ts:rollUpLatencyBuckets`），
/// 因此同一 (节点, 目标, 小时, 口径) 只有一行，且聚合是幂等的：小时结束后不再有新样本，
/// 重算结果相同。桶一旦写入不再改写（`create` + 唯一冲突跳过），保持档案的只追加性质。
///
/// **延迟统计只统计真的测到延迟的样本**（`latency_samples` = 参与统计的样本数）：
/// 不可达样本计入 `sample_count`/`failure_count`，但不进平均 —— 把"没测到"算成 0ms
/// 会让一次断线在图上显示成"延迟骤降 0"，那是最坏的一类谎言。
model TargetLatencyHourly {
  id      Int  @id @default(autoincrement())
  node_id Int
  node    Node @relation(fields: [node_id], references: [id], onDelete: Cascade)

  target_key String   @db.VarChar(288)
  /// 该小时桶的起点（UTC 整点）。横轴口径：`observed_at` 落在 [hour_start, hour_start+1h)。
  hour_start DateTime
  /// 观测口径（与样本同源）：不同 source 的延迟**不并排、不平均**（D12）。
  observation_source String @db.VarChar(64)

  /// 样本总数与可达/不可达分解（`success_count + failure_count == sample_count`）。
  sample_count  Int
  success_count Int
  failure_count Int

  /// 延迟统计：`latency_sum_ms / latency_samples` = 平均值；`latency_samples = 0`
  /// 时平均值是 NULL（**不是 0**）。min/max 让抖动在小时粒度上也留痕。
  latency_samples  Int
  latency_sum_ms   Float
  latency_min_ms   Int?
  latency_max_ms   Int?
  last_observed_at DateTime

  created_at DateTime @default(now())

  @@unique([node_id, target_key, hour_start, observation_source])
  /// 清理：`hour_start < cutoff` 按索引删。
  @@index([hour_start])
  @@map("target_latency_hourly")
}

model NodeStateReport {
  id      Int  @id @default(autoincrement())
  node_id Int  @unique
  node    Node @relation(fields: [node_id], references: [id], onDelete: Cascade)

  /// Agent 版本号（面板据此提示节点升级）
  version String? @db.VarChar(255)
  /// 自报角色，与 node.role 对齐校验（不一致按 node.role 为准并在返回里标注）
  role    String? @db.VarChar(32)
  /// Agent 已知的最新 revision（与 Tunnel.config_revision 对比判断是否落后）
  reported_revision Int?
  /// 隧道快照 JSON：`{ "tunnels": [ { "id", "mode", "ingress_port", "egress_port", "revision", "targets"? } ] }`
  tunnels         Json?
  /// 出口池快照 JSON：`{ "<tunnelId>": { "strategy", "targets": [ "host:port" ] } }`
  egress_pools    Json?
  /// 已占用端口列表（agent 侧 usedPorts）
  used_ports      Json?
  /// Agent 自述的最近错误（无则 null；不写凭据）
  last_error      String?  @db.VarChar(500)
  /// 面板收到本次上报的时刻（非 Agent 时钟，供离线判定用 DB 侧单一真相）
  reported_at     DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  // ── V4-WP6 Agent Telemetry（§13.4.4，迁移 20260928000000）──
  //
  // 全部可空，且**没有默认值**：存量行从未有过这些事实，`NULL` 就是
  // 「Agent 还没报过」，health synthesis 靠它判 `unknown`。给默认值会把
  // 未知抹成 0（0 字节内存 / 0 个 runtime），那是把未知渲染成故障。
  //
  // 每列与 §13.4.4 要求项的对应：
  //   known_revision  ← latest known revision（与 reported_revision 比较即
  //                     区分「面板在推但节点应用不了」与「节点已最新」）
  //   agent_started_at← Agent 启动时间 / uptime
  //   hostname/os/arch← hostname、OS、arch
  //   runtime_counts  ← DIRECT / RELAY ingress / Egress runtime 数量
  //   host_metrics    ← CPU / memory / disk / load 轻量当前值
  //   error_count / last_error_at ← 「最近 runtime/apply error」的持续性与时刻

  /// Agent 在信封里**见过**的最新 revision（不是已应用的那条）
  known_revision   Int?
  /// Agent 进程启动时刻（面板据此算 uptime，不用 Agent 时钟做算术）
  agent_started_at DateTime?
  /// 主机名（重装才会变）
  hostname         String?  @db.VarChar(255)
  /// runtime.GOOS
  os               String?  @db.VarChar(32)
  /// runtime.GOARCH
  arch             String?  @db.VarChar(32)
  /// `{ direct, relay_ingress, relay_egress, total }`（Agent 自报的分类计数）
  runtime_counts   Json?
  /// 轻量资源采样：`{ cpu_count, load1..15, memory_*, disk_*, host_uptime_seconds,
  /// process_rss_bytes }`；缺失分组不写键（面板按「未知」处理）
  host_metrics     Json?
  /// 累计 apply/runtime 错误条数（NULL = 旧 Agent 没这个账本）
  error_count      Int?
  /// 最近一次错误时刻（NULL = 从未出错或旧 Agent）
  last_error_at    DateTime?

  // ── V4-WP11B 控制协议协商（§13.5）──
  //
  // 两个字段都是**可空且无默认值**：NULL 明确表示「这个 Agent 没有协商能力」
  // （旧版本 Agent），而不是「支持版本 0 / 能力为空」。这个区别决定了面板能
  // 不能对旧 Agent 下发新动作——把 NULL 当 0 会把升级窗口变成一次全网中断。
  //
  //   control_protocol_version ← Agent 实现的控制协议版本（整数，单调增）
  //   capabilities             ← Agent 实际实现的动作清单（字符串数组，
  //                              由 Agent 侧 execute 分支的真实实现派生，
  //                              不是"理论上支持"的清单）
  /// Agent 实现的控制协议版本（NULL = 旧 Agent 未上报）
  control_protocol_version Int?
  /// Agent 实际实现的控制动作清单（NULL = 未上报；非数组 = 坏形状，fail-closed）
  capabilities             Json?

  // ── V5-WP1 能力协商 v2（DEVELOPMENT.md §5.2）──
  //
  // 第三个**可空且无默认值**的协商字段，additive 且不改动上面两列的语义。
  //
  //   capability_manifest ← { schema_version, protocols, transports,
  //                           runtime, diagnostics }
  //
  // 为什么不把 capabilities 原地改成 object：它是 string[]，Support Bundle /
  // 诊断快照 / 旧工具链已经按数组读它；原地改型会让每个读它的人静默拿到
  // undefined，把「节点支持 apply_tunnel」变成「什么都不知道」。
  //
  // NULL 的含义与 capabilities 完全一致（旧 Agent 未上报 → baseline 放行），
  // 形状校验由 node-state.ts 与 services/capability-manifest.ts 双重把关。
  /// Agent 实际实现的协议 / 传输 / runtime 能力清单（NULL = 未上报）
  capability_manifest      Json?

  @@index([reported_at])
  @@index([last_error_at])
  @@map("node_state_report")
}

/* ================================================================== */
/* V5-WP13.5B —— Route Profile（DEVELOPMENT.md §9.4.2–§9.4.6）          */
/* 契约：docs/v5-wp13-5b-route-profile-contract.md（FROZEN）            */
/* ================================================================== */

/// Route Profile = 可复用、可版本化的**线路模板/意图**。
///
/// 它**拥有**：模板意图（ingress selector / ordered transit[] / egress selector）、
/// ingress·egress policy、health/placement constraints、required capabilities、
/// name/description/visibility/enabled、version 账本、ASSIGNED 授权归属。
///
/// 它**不拥有**：Agent runtime、NodePortLease / placement lease、Forward lifecycle、
/// applied revision、traffic counter、独立 reconcile、独立 restart/stop 状态机 ——
/// 因此本表刻意没有 status / applied_* / traffic_* 列，也没有任何状态机字段。
/// 「apply」只能通过既有 `patchForward` → `createForwardRevision` → `registerRollout`
/// 产生效果（不新建下发通道）。
///
/// `version` 1 起单调递增。模板内容变更**只能**通过发布新版本（写
/// `route_profile_version` 的不可变行），本行上的模板列只是**当前版本的投影**
/// ——与 `tunnel` ↔ `forward_revision` 的投影关系同一模式，不是第二份真相。
///
/// 为什么 `workspace_id` / `user_id` **不加关系**：本文件是多人共享的 schema，
/// 只做最小 diff（不新增 Workspace/User 的反向关系）；且 Route Profile 的删除是
/// 服务层的显式事务（含 profile_in_use 守卫），不依赖数据库级联。
model RouteProfile {
  id           Int     @id @default(autoincrement())
  workspace_id Int
  /// 创建者（审计归属，与 node_group 口径一致）。
  user_id      Int
  name         String  @db.VarChar(120)
  description  String? @db.VarChar(500)
  /// INTERNAL | ASSIGNED | PUBLIC。**字符串列 + 应用层校验**：§3.4 禁止用 DB enum
  /// 承载会频繁扩展的集合；未知值一律 fail-closed（不默认降级）。
  visibility   String  @default("INTERNAL") @db.VarChar(20)
  /// 关闭后不再可用于新的 apply、不再对消费者可见；**已应用的 Forward 不受影响**。
  enabled      Boolean @default(true)
  /// 当前已发布版本号（1 起）。0 = 尚未发布任何版本的残缺行（正常路径不会出现）。
  version      Int     @default(0)

  /// ── 当前版本内容的投影（唯一权威是 route_profile_version.body）──
  /// `{kind:"fixed_node",node_id}` | `{kind:"node_group",node_group_id,strategy}`
  ingress_selector   Json?
  /// **有序**数组，第一版元素只允许 `{kind:"fixed_node",node_id}`（dynamic middle
  /// pool 关闭，见 §9.4.4 第 4 条）。
  transit_selectors  Json?
  /// `null` = DIRECT（出口就是 ingress 那一跳）。
  egress_selector    Json?
  ingress_policy     Json?
  egress_policy      Json?
  /// health / placement 约束（白名单键；未知键 fail-closed）。
  constraints        Json?
  /// required capabilities（字符串数组；解析出的每个节点都必须满足）。
  required_capabilities Json?

  published_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([workspace_id, name])
  @@index([workspace_id, enabled])
  @@index([visibility, enabled])
  @@map("route_profile")
}

/// 某一个版本的**不可变**模板内容。
///
/// 存在的理由与 `forward_revision` 同源：编辑共享模板绝不能静默改写正在运行的
/// Forward。运行时解释链是「ForwardRevision → route_profile_version → 模板内容」，
/// 而模板行随时会变；只有这张表能回答「rev 12 当时用的是哪个版本的什么内容」。
///
/// 与 `forward_revision` 一样，`body` 写入后没有任何代码路径 update 它。
model RouteProfileVersion {
  id               Int          @id @default(autoincrement())
  route_profile_id Int
  /// 1 起单调递增；(route_profile_id, version) 唯一 —— 并发发布由它兜底。
  version          Int
  /// 该版本完整模板内容：
  /// `{ ingress, transit[], egress, ingress_policy, egress_policy,
  ///    constraints, required_capabilities }`
  body             Json
  /// 人读的变更摘要（解释链的第二来源，不参与判定）。
  change_summary   String?      @db.VarChar(500)
  /// 发布人（审计上下文）。无 FK：用户删除不得改写历史。
  created_by_id    Int?
  created_at       DateTime     @default(now())

  @@unique([route_profile_id, version])
  @@index([route_profile_id, created_at])
  @@map("route_profile_version")
}

/// ASSIGNED 可见性的授权行：把模板显式授权给某个 Workspace 或 Plan。
///
/// `target_type` 用字符串列（workspace | plan，可扩展），不做 DB enum（§3.4）。
/// `target_id` **不加 FK**：授权对象的删除不得静默改写「曾经授权过谁」的事实，
/// 悬空引用由读取方按「无效授权 ⇒ 不可见」处理（fail-closed）。
///
/// 本版只做**可见性/可选性判定与只读接口**；套餐/计费的 entitlement 落库不在本 WP。
model RouteProfileAssignment {
  id               Int     @id @default(autoincrement())
  route_profile_id Int
  /// workspace | plan（应用层白名单校验）。
  target_type      String  @db.VarChar(20)
  target_id        Int
  active           Boolean @default(true)
  created_at       DateTime @default(now())

  // 复合唯一索引**显式命名**：MySQL 的标识符上限是 64 字符，Prisma 默认名
  // （route_profile_assignment_route_profile_id_target_type_target_id_key）是 67，
  // 空库 migrate deploy 会以 MySQL 1059 直接失败。
  @@unique([route_profile_id, target_type, target_id], map: "route_profile_assignment_target_key")
  @@index([target_type, target_id, active])
  @@map("route_profile_assignment")
}

/// `apply` 账本：一条 ForwardRevision 来自哪个 Route Profile / 版本，解析到了哪些具体节点。
///
/// **不是第二套真相，也不驱动任何状态机**：它只是申请记录 + 排障解释链
/// （「这次为什么发到这些节点」）。真正的执行路径仍读 `forward_revision` 的
/// `resolved_hops` / ingress / egress / middle 列；rollout 进度仍读 `forward_rollout`。
///
/// 保留 apply 历史（不随模板删除而消失）正是这张表的价值：模板被删掉之后，
/// 「当时是谁申请把哪个版本铺到这条 Forward 上」仍然可查。
model RouteProfileApplication {
  id                    Int      @id @default(autoincrement())
  route_profile_id      Int
  route_profile_version Int
  tunnel_id             Int
  /// 本次 apply 生成的 Forward revision（与 forward_revision.revision 同值）。
  forward_revision      Int
  /// 编译器解析出的具体跳（[{hop_index, role, node_id}]），与 revision 快照同一份事实。
  resolved_hops         Json
  /// 发起人（审计上下文）。
  applied_by_id         Int?
  created_at            DateTime @default(now())

  @@index([tunnel_id, created_at])
  // 显式命名：默认名 route_profile_application_route_profile_id_route_profile_version_idx
  // 是 68 字符，超过 MySQL 的 64 字符标识符上限（P3018 / MySQL 1059）。
  @@index([route_profile_id, route_profile_version], map: "route_profile_application_profile_version_idx")
  @@map("route_profile_application")
}

/* ================================================================== */
/* V5.5 Federation（WP14 / WP15 / WP16）                               */
/*                                                                     */
/* 契约：docs/v5-wp14-16-federation-contract.md                        */
/*                                                                     */
/* 三条与别处一致的设计取向：                                          */
/*   1. 会扩展的集合（status / state）用**字符串列 + 应用层校验**，不用  */
/*      DB enum —— §3.4：enum 加值会让旧二进制读到未知值时失败。        */
/*   2. 跨面板引用本机资源（tunnel / node / workspace）**不加外键**：    */
/*      删掉一条 Forward 不得抹掉「当时联邦把哪条链路租给了谁」的历史，  */
/*      校验悬空引用是读取方的职责（与 forward_revision / node_port_    */
/*      lease 的既有先例同一取向）。                                    */
/*   3. 私钥只以密文落地；公钥不是秘密。                                */
/* ================================================================== */

/// 本 Panel 的联邦身份。单行表（`panel_id` 唯一且不变）。
model FederationSetting {
  id              Int      @id @default(autoincrement())
  /// 本机 panel_id（UUID）。卸载重装才会变。
  panel_id        String   @unique @db.VarChar(64)
  /// 当前签名密钥的 key_id（= sha256(public_key) 前 16 hex）。
  key_id          String   @db.VarChar(64)
  /// Ed25519 私钥 JWK 的密文（AES-256-GCM，密钥由 AUTH_SECRET 经 HKDF 派生）。
  private_key_enc String   @db.Text
  /// 公钥 JWK（明文，用于对外公布与本地校验）。
  public_key      Json
  /// 联邦功能总开关。默认关闭：未显式开启前所有联邦端点为 `federation_disabled`。
  enabled         Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("federation_setting")
}

/// 远端 Panel（peer）。本机对它的信任状态是**本机事实**，不因远端声明而改变。
model FederationPeer {
  id            Int       @id @default(autoincrement())
  peer_panel_id String    @unique @db.VarChar(64)
  display_name  String    @db.VarChar(120)
  /// 出站调用地址（scheme://host:port，不含路径）。
  endpoint_url  String    @db.VarChar(255)
  /// 当前可验签的公钥集合：`[{key_id, jwk, state: active|retiring|retired, not_after}]`。
  public_keys   Json
  /// pending | trusted | suspended | revoked
  status        String    @db.VarChar(32) @default("pending")
  /// 信任范围（允许的 hop role / 能力），应用层校验；null = 未授予任何范围。
  trust_scope   Json?
  /// 入站请求的远端自述信息（仅诊断用，不作为授权依据）。
  last_seen_at  DateTime?
  revoked_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  credentials FederationCredential[]
  grants      FederationGrant[]

  @@index([status])
  @@map("federation_peer")
}

/// 信任引导 / 密钥对接的一次性凭据（沿用 node_enrollment 的模式：
/// 明文只出现一次，库里只有 sha256；过期 + 一次性消费 + 可撤销）。
model FederationCredential {
  id         Int            @id @default(autoincrement())
  peer_id    Int
  peer       FederationPeer @relation(fields: [peer_id], references: [id], onDelete: Cascade)
  /// 一次性 token 的 sha256（明文不落库、不回显、不进审计 metadata）。
  token_hash String         @unique @db.Char(64)
  /// bootstrap | rotate
  purpose    String         @db.VarChar(32) @default("bootstrap")
  expires_at DateTime
  used_at    DateTime?
  revoked_at DateTime?
  created_at DateTime       @default(now())

  @@index([peer_id, expires_at])
  @@map("federation_credential")
}

/// 跨面板消息回执：replay 防护（唯一键去重）+ 幂等（重投递返回首次响应快照）。
model FederationMessageReceipt {
  id            Int      @id @default(autoincrement())
  /// `<direction>:<peer_panel_id>:<message_id>`
  message_key   String   @unique @db.VarChar(191)
  peer_panel_id String   @db.VarChar(64)
  /// inbound | outbound
  direction     String   @db.VarChar(16)
  /// 归一化路径（数字段 → :id），便于两侧审计互查。
  path          String   @db.VarChar(191)
  status        Int
  /// 首次响应快照；重复投递原样返回，不再执行第二次。
  response_body Json?
  created_at    DateTime @default(now())

  @@index([created_at])
  @@index([peer_panel_id, created_at])
  @@map("federation_message_receipt")
}

/// 授予：host 侧权威。grant 只说明「愿意提供多少容量」，
/// **不等于授权**（§1.6）—— 每次 intent 仍要过 host 自己的 RBAC / scope / quota。
model FederationGrant {
  id             Int            @id @default(autoincrement())
  peer_id        Int
  peer           FederationPeer @relation(fields: [peer_id], references: [id], onDelete: Cascade)
  /// 对外引用的 UUID（内部主键不外泄）。
  grant_ref      String         @unique @db.VarChar(64)
  /// 允许被哪个本地 Workspace 消费（null = 该 peer 的全部已授权 workspace）。
  workspace_id   Int?
  /// 单调递增；容量/范围/过期任一实质变更都 +1，绝不回退。
  grant_epoch    Int            @default(1)
  /// active | suspended | revoked | expired
  status         String         @db.VarChar(32) @default("active")
  /// `{node_group_ids, hop_roles, allow_target_policy}`；应用层校验，未知键 fail-closed。
  scope          Json
  /// `{max_legs, max_bandwidth_mbps, max_connections}`；null 键 = 该维度不限（仍受本地 quota）。
  capacity       Json
  /// true = 签发即从本地 quota 预留，撤销/过期归还。
  quota_reserved Boolean        @default(false)
  expires_at     DateTime
  revoked_at     DateTime?
  created_by_id  Int?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  leases FederationLease[]

  @@index([peer_id, status])
  @@index([expires_at])
  @@map("federation_grant")
}

/// 远端租约（host 侧权威）：某个 peer 在**本机某个节点**上占用的一段运行时。
/// host 是这张表与相关端口租约的唯一写者；home 侧只持镜像。
model FederationLease {
  id                 Int             @id @default(autoincrement())
  lease_ref          String          @unique @db.VarChar(64)
  grant_id           Int
  grant              FederationGrant @relation(fields: [grant_id], references: [id], onDelete: Cascade)
  peer_panel_id      String          @db.VarChar(64)
  /// 远端 Forward 的不透明引用（home 侧自己解释；host 不建本地 Forward 行）。
  forward_ref        String          @db.VarChar(191)
  /// home 侧发起意图的 id（幂等键之一）。
  intent_id          String          @db.VarChar(64)
  /// reserved | active | releasing | released | expired | revoked | failed
  state              String          @db.VarChar(32) @default("reserved")
  /// 单调递增、绝不复用：撤销/过期后重新占用必须是新 epoch（fencing 依据）。
  lease_epoch        Int             @default(1)
  /// ingress | egress | transit
  hop_role           String          @db.VarChar(16)
  /// 本机节点 id（无 FK：删除节点不得改写租约历史）。
  node_id            Int?
  listen_port        Int?
  requested_revision Int             @default(0)
  applied_revision   Int?
  /// V5.5 WP15：**已应用的那份 Agent 运行时配置原文**（与下发同一份事实，不再在快照里重拼）。
  /// host 的权威 desired 快照据此把联邦腿发布给自己的 Agent；NULL = 从未成功应用过。
  applied_config     Json?
  last_error_code    String?         @db.VarChar(64)
  last_error         String?         @db.Text
  expires_at         DateTime
  applied_at         DateTime?
  released_at        DateTime?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  intents FederationIntent[]

  @@index([peer_panel_id, state])
  @@index([expires_at])
  @@index([node_id])
  @@index([grant_id, state])
  @@map("federation_lease")
}

/// 跨面板动作台账（host 侧）：(intent_id, revision, action) 幂等。
model FederationIntent {
  id            Int              @id @default(autoincrement())
  intent_id     String           @db.VarChar(64)
  peer_panel_id String           @db.VarChar(64)
  lease_id      Int?
  lease         FederationLease? @relation(fields: [lease_id], references: [id], onDelete: SetNull)
  revision      Int
  /// create | apply | release | renew
  action        String           @db.VarChar(32)
  /// ok | failed
  status        String           @db.VarChar(32)
  error_code    String?          @db.VarChar(64)
  created_at    DateTime         @default(now())

  @@unique([intent_id, revision, action])
  @@index([peer_panel_id, created_at])
  @@map("federation_intent")
}

/// 远端 placement 的本地镜像（home 侧）。**只是账本证据**：
/// reconcile 的权威期望仍是 Forward desired（§1.4），本表不参与期望状态计算。
model FederationPlacement {
  id               Int       @id @default(autoincrement())
  peer_panel_id    String    @db.VarChar(64)
  forward_ref      String    @db.VarChar(191)
  /// 本机 Forward/Tunnel id（无 FK：删 Forward 不得抹掉联邦历史）。
  tunnel_id        Int?
  intent_id        String    @db.VarChar(64)
  lease_ref        String?   @db.VarChar(64)
  lease_epoch      Int       @default(0)
  /// ingress | egress | transit
  hop_role         String    @db.VarChar(16)
  desired_revision Int       @default(0)
  applied_revision Int?
  /// pending | active | degraded | expired | revoked | failed
  state            String    @db.VarChar(32) @default("pending")
  /// 不透明远端引用：仅供显示与诊断，**不得**据此建本地 node 行。
  peer_node_ref    String?   @db.VarChar(64)
  peer_port        Int?
  last_error_code  String?   @db.VarChar(64)
  last_error       String?   @db.Text
  expires_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@unique([peer_panel_id, intent_id])
  @@index([tunnel_id])
  @@index([state])
  @@map("federation_placement")
}

/// 用量事实（home 侧收到的上报）。按 `usage_id` 去重；
/// 缺失窗口**不补 0**（「不知道」不是「零流量」）。
model FederationUsageRecord {
  id            Int      @id @default(autoincrement())
  usage_id      String   @unique @db.VarChar(96)
  peer_panel_id String   @db.VarChar(64)
  lease_ref     String   @db.VarChar(64)
  forward_ref   String?  @db.VarChar(191)
  /// 归因到的本机 Forward（无 FK，理由同 FederationPlacement）。
  tunnel_id     Int?
  window_start  DateTime
  window_end    DateTime
  bytes_in      BigInt   @default(0)
  bytes_out     BigInt   @default(0)
  connections   Int      @default(0)
  /// attributed | unattributed（无法归因的用量进 unattributed 桶并告警，不静默丢弃）。
  attribution   String   @db.VarChar(32) @default("unattributed")
  received_at   DateTime @default(now())

  @@index([lease_ref, window_start])
  @@index([tunnel_id, window_start])
  @@index([peer_panel_id, window_start])
  @@map("federation_usage_record")
}

/// V5-WP18.2 —— 通知投递账本（契约 F3/F4）。
///
/// 这张表**只描述「尝试投递」**，不是事实源（C2）：删掉全部行不影响任何判定，
/// 通知的真相永远在它派生的那张既有表（`node` / `tunnel` / …）。
///
/// 设计要点：
///   · `dedupe_key` = sha256(scope, source_kind, source_id, reason_code, window_start)，
///     与 `channel_kind` 组成唯一索引：同一事实同一渠道在一个静默窗内**只落一行**
///     （F4.2 的"唯一索引兜底"，api 与 worker 两个进程并发派生也不会各发一次）；
///   · 唯一索引必须带 `channel_kind`：契约 F3 要求"每渠道各自一条投递记录"，
///     而 F4.2 的 `dedupe_key` 组成里**没有**渠道——两处要求联立后只剩这一种解；
///   · `status` 从 `sending` 起步再收敛为 `sent`/`failed`：先占位、后投递，
///     并发下第二个进程会在唯一索引上撞键而不是发出第二封信（R7 的三层防线）；
///   · `degraded` 记「静默期降级」：Redis 不可用时仍发送（O2 裁决），但必须留下
///     "这次去重是进程内近似"的痕迹，否则事后无法解释重复投递；
///   · 不建 workspace 外键（与 FederationPlacement 同一取向）：账本是历史证据，
///     删 workspace 不该抹掉"我们给谁发过什么"，孤儿 id 比级联删除更可接受；
///   · 全部用 String 而不是 DB enum：F5 已冻结"additive、不引 DB enum"——
///     enum 增删值都会让旧二进制读到未知值时失败。
model NotificationDelivery {
  id             Int      @id @default(autoincrement())
  /// platform | workspace（与 NotificationScope 同源；结构上 platform ⟹ workspace_id = NULL）。
  scope_kind     String   @db.VarChar(16)
  workspace_id   Int?
  /// 幂等键（64 位十六进制），与契约 F4.2 的组成一一对应。
  dedupe_key     String   @db.VarChar(64)
  /// N1–N6 封闭枚举（node | forward | reconcile_finding | workspace_event | federation_event | announcement）。
  source_kind    String   @db.VarChar(32)
  /// 既有表主键（F8-B：不存在指向不存在行的投递）。
  source_id      String   @db.VarChar(191)
  /// 既有词表的原因码（attention 的 AttentionReasonCode）。
  reason_code    String   @db.VarChar(64)
  severity       String   @db.VarChar(16)
  resource_type  String   @db.VarChar(64)
  resource_id    String   @db.VarChar(191)
  channel_kind   String   @db.VarChar(16)
  /// 投递目标（邮箱地址 / webhook URL / chat id）。**绝不含凭据**：
  /// webhook 的密钥不得出现在这里，URL 必须由渠道自己脱敏后回传（WP18.3）。
  target         String   @db.VarChar(512)
  /// sending | sent | failed。
  status         String   @db.VarChar(16) @default("sending")
  /// 失败原因（not_configured | transport_error | rejected_target | unsupported_channel |
  /// secret_unreadable | ledger_unavailable）。`secret_unreadable` 是 WP18.4 追加的：
  /// 凭据存在但解不开/不可用必须与"没配置"分开，否则一次密钥事故会被显示成"看起来没配"。
  failure_reason String?  @db.VarChar(32)
  /// 实际尝试次数（有界：≤ 3）。
  attempts       Int      @default(0)
  /// 静默期判定是否降级（Redis 不可用 → 进程内近似去重）。
  degraded       Boolean  @default(false)
  /// 错误摘要（已截断；不允许原文里的凭据落地）。
  error          String?  @db.Text
  /// 事实的发生时刻（来源表上的既有时间戳）。
  occurred_at    DateTime
  /// 幂等键的时间窗下界（诊断列：回答"下一条要等多久"）。
  window_start   DateTime
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // `map:` 是**有意的**：迁移是手写的，索引名是人挑的可读名（`..._dedupe_channel_key`）。
  // 不写 map，Prisma 会按列名推导出 `..._dedupe_key_channel_kind_key` 并认为两边不一致 ⇒
  // 漂移检查每次都报"重命名"，而 `migrate dev` 会真的去重命名。名字要么在 schema 里定死，
  // 要么在迁移里改成 Prisma 的默认推导 —— 这里选前者（可读性优先，且迁移已经落地）。
  @@unique([dedupe_key, channel_kind], map: "notification_delivery_dedupe_channel_key")
  @@index([workspace_id, created_at], map: "notification_delivery_workspace_created_idx")
  @@index([source_kind, source_id], map: "notification_delivery_source_idx")
  @@index([status, created_at], map: "notification_delivery_status_created_idx")
  @@map("notification_delivery")
}

/// V5-WP18.3 / WP18.4 —— 通知渠道配置（契约 F5）。
///
/// ── 为什么是独立表，而不是 `SystemConfig` 键 ──
/// `config.value` 是**明文**、按名字 upsert、且公网免认证下发面会读它（`routes/public.ts`）。
/// 把 bot token / webhook URL 放进去，等于把凭据写进一张"可能被非超管读到、且无轮换语义"的表。
/// 渠道配置要按 scope 归属、要有密文列、要能被停用 —— 这三件事都需要真正的列。
///
/// ── 三条设计要点 ──
///   · `secret_enc` 只存**密文**（AES-256-GCM，`v1.<iv>.<ct>.<tag>` 单行），密钥由
///     `notification-seal.ts` 用**独立 HKDF info**（`tunex-notification-v1`）派生 ——
///     绝不与联邦/DDNS 共用派生密钥（R5：一处泄漏不该等于两处泄漏）。明文只出现一次
///     （写入响应体），此后任何读取路径都不得回显它。
///   · **不建唯一索引**（`(scope_kind, workspace_id, kind)` 看起来很像该唯一，其实不成立）：
///     platform 行的 `workspace_id` 是 NULL，而 MySQL 唯一索引里 NULL 互不相等 ——
///     加了它只会给出**假的排他性**（平台侧照样能插两条 telegram）。
///     "一 scope 一 kind" 若要成立，得用生成列或在应用层加锁，那是接线 WP 的取舍。
///   · 不建外键（与 `NotificationDelivery` 同一取向）：渠道配置是运维资产，
///     删 workspace 该由接线层显式清理，而不是被级联删掉后无人知晓。
model NotificationChannel {
  id            Int      @id @default(autoincrement())
  /// platform | workspace（与 NotificationScope 同源）。
  scope_kind    String   @db.VarChar(16)
  /// platform ⟹ NULL（结构上表达 F5 的边界，不用"约定"）。
  workspace_id  Int?
  /// email | webhook | telegram（与 NotificationChannelKind 同源；不用 DB enum，见上）。
  kind          String   @db.VarChar(16)
  /// 投递目标（webhook URL / chat id / 收件人）。**token 不放这里**：它属于 `secret_enc`。
  /// 注意 webhook URL 本身常常就是凭据（Slack/Discord 的 hook URL），因此**写进投递账本**时
  /// 必须经渠道的 `redactTarget()` 脱敏（WP18.3），而不是把这里的原文抄过去。
  target        String   @db.VarChar(512)
  /// 凭据密文（`notification-seal.ts` 的 `sealNotificationSecret()` 是唯一落库入口）。
  secret_enc    String?  @db.Text
  /// 停用 ≠ 删除：停用后 `telegramSealedTokenFromRow()` 返回 null ⇒ 渠道未配置
  /// ⇒ 投递层留一条 `not_configured`，而不是静默不发。
  enabled       Boolean  @default(true)
  /// 创建者（平台超管 / 租户管理员）。**不做外键**：审计线索比约束更重要。
  created_by_id Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([scope_kind, workspace_id, kind], map: "notification_channel_scope_idx")
  @@map("notification_channel")
}

/* ================================================================== */
/* V5-WP18.5（契约 F6）—— 公告 / 已读 / 免打扰                        */
/* ================================================================== */

/// 公告：平台或租户写给「人」的内容，有生命周期与已读状态（契约 §0 的定位）。
///
/// ── 为什么它**不**经过 `NotificationFact` ──
/// F1 把通知层的地基写成「既有状态机 / 对账事件的派生物」，而公告的真相**就在这张表里**
/// （F2-N6：来源 = 公告表自身）。把它塞进 `NotificationFact.reason_code`（= 同一份
/// `AttentionReasonCode`）就必须为「公告」新造一个 attention 原因码 —— 那等于在
/// 「通知只消费既有词表」这条不变量上开一个例外。因此公告的推送走渠道层的
/// `RenderedNotification` + 同一套免打扰判据（`announcement-mute.ts`），
/// 投递账本与静默期仍归 WP18.2 的 `notification-delivery.ts`（见契约 §12）。
model Announcement {
  id               Int       @id @default(autoincrement())
  /// platform | workspace。与 `NotificationScope`（`notification-facts.ts`）同源：
  /// `platform` ⟹ `workspace_id = NULL`。**用结构表达边界**（F6.2）——服务层的入参类型
  /// 就是那个判别联合（`AnnouncementScope = NotificationScope`），
  /// 「平台公告挂到某个租户」在类型层面写不出来，不靠约定或调用方自觉。
  scope_kind       String    @db.VarChar(16)
  /// 归属租户。platform 一律 NULL；租户侧的读取条件由 `visibleAnnouncementWhere()` 强制给出。
  workspace_id     Int?
  /// normal | popup。`upgrade_popup` 不移植（O3：TuneX 用 git sha，没有权威版本矩阵）。
  type             String    @db.VarChar(16)
  title            String    @db.VarChar(200)
  /// 正文是**纯文本**：全仓零 HTML 净化器、零 `dangerouslySetInnerHTML`（F6.6 / DoD7）。
  /// 不引入 HTML 就没有 XSS 面 —— 存普通文本 + 前端纯文本渲染是这条纪律的可执行形式。
  body             String    @db.Text
  /// 活跃弹窗的**结构唯一键**：`platform` / `workspace:<id>`；normal 或已撤回时为 NULL。
  ///
  /// 为什么不写成 `@@unique([scope_kind, workspace_id, type])`：MySQL 的唯一索引把 NULL
  /// 当作互不相等 ⇒ 平台行（`workspace_id IS NULL`）之间永远不会冲突，约束形同虚设。
  /// 这一列把「哪一格被占」写成一个**非空标量**，于是唯一索引真的能拒绝第二条活跃弹窗：
  /// Forwardx 靠「先关旧的再插新的」，并发下会留下两条（契约 F6.3 的反面教材）。
  active_popup_key String?   @unique(map: "announcement_active_popup_key") @db.VarChar(64)
  /// 发布时间（可见性起点）。迁移来的旧 `NOTICE` 用 `config.updated_at` ——
  /// **来源表上的既有时间戳**，不是「迁移跑起来的时刻」。
  published_at     DateTime
  /// 撤回时刻。撤回 ≠ 删除：发出去过的内容撤下后仍留存（R3 的「同一发布里切换」）。
  revoked_at       DateTime?
  /// 发布者。**可空**且**不建外键**（理由与 `notification_delivery` 一致）：
  /// ① 迁移来的旧公告没有作者，不猜一个出来；② 删用户不该把公告一起抹掉，
  /// 而加外键要给既有 `User` 模型补反向关系列 —— 那是改别人的模型。
  created_by_id    Int?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  dismissals AnnouncementDismissal[]

  @@index([scope_kind, workspace_id, published_at], map: "announcement_scope_published_idx")
  @@map("announcement")
}

/// 已读 = **每用户一条 dismiss 记录**（F6.5），不是全量已读清单：
/// 公告数量会增长，而「这个人读过哪几条」一行一条就够，不需要为每条公告写 N 行。
model AnnouncementDismissal {
  id              Int      @id @default(autoincrement())
  announcement_id Int
  user_id         Int
  dismissed_at    DateTime @default(now())

  /// 外键只指向**本 WP 自己的表**（Cascade）：公告被删时它的已读记录没有意义。
  /// 注意 `user_id` 刻意**不**建外键 —— 同样是「不改别人的模型」。
  announcement Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)

  @@unique([announcement_id, user_id], map: "announcement_dismissal_unique")
  @@map("announcement_dismissal")
}

/// 免打扰 = **每用户 × 每渠道 × 每类别**三元映射（F6.5）。只影响**推送**：
/// `GET /api/announcements` 与 dismiss **结构上**不读这张表（服务的入参里没有 mutes），
/// 所以「用户免打扰了 email」不会让站内公告消失、也不会改变已读状态。
model NotificationMute {
  id           Int      @id @default(autoincrement())
  user_id      Int
  /// `NOTIFICATION_CHANNEL_KINDS`（`notification-delivery.ts`）：email | webhook | telegram。
  /// 复用既有闭集：渠道类型只允许一处定义，否则「哪个渠道能被静音」会有两份答案。
  channel_kind String   @db.VarChar(16)
  /// 类别 = `NOTIFICATION_SOURCE_KINDS`（`notification-facts.ts`）。**不新造类别词表**：
  /// 免打扰要回答的是「这类通知要不要推给我」，而类别本身就来自通知触发源的封闭白名单。
  category     String   @db.VarChar(32)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([user_id, channel_kind, category], map: "notification_mute_unique")
  @@map("notification_mute")
}
