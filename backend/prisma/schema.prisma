enum SystemConfigName {
  MIN_TOPUP_AMOUNT
  /// V5.3 WP10：自动故障转移/回切的运维策略（JSON：`{auto_failover, auto_failback}`）。
  /// 缺省不存在 ⇒ 两个都视为 false（fail-closed：策略没被配置过就不许自动搬流量）。
  FAILOVER_POLICY
  /// @deprecated V5-WP18.5（契约 F6.7）：公告的真相已经迁到 `announcement` 表。
  ///
  /// **只读保留**：迁移 `20261033000000_v5_wp18_announcements` 把非空值读走成一条
  /// `type="normal"` 公告（读 `config`，**从不写回**），`routes/public.ts` 已把它从免认证
  /// 下发面移除，写入路径也不再使用它 —— 留着就是一个「沉睡又被免认证下发」的键，
  /// 正是双份公告真相的来源。
  ///
  /// 枚举值**一个都不能删**：MySQL 的 ENUM 是序号存储，删值会让旧二进制读到未知值时直接失败
  /// （契约 §9.8 / §F6.7）。
  NOTICE
  /// @deprecated V5-WP18.5（契约 F6.7）：弹窗开关。
  ///
  /// 弹窗现在由 `announcement.type="popup"` + `active_popup_key` 上的唯一索引表达
  /// （同 scope 只允许一条活跃）。本键**不做内容迁移**：它是布尔开关，不是内容 ——
  /// 内容在 `NOTICE` 里，已经迁走。保留仅为旧二进制读取不失败。
  NOTICE_POPUP
  /// @deprecated V5-WP18.5（契约 F6.7）：弹窗间隔小时数。
  ///
  /// 同 `NOTICE_POPUP`：**不迁移、不删值**。间隔语义属于前端展示节奏，不是公告事实。
  NOTICE_POPUP_INTERVAL_HOURS
  SITE_NAME
  SITE_DESCRIPTION
  ALLOW_REGISTER
  LOGO_URL
  HIDE_NODE_STATUS
  AUTO_UPDATE_AGENT
  CHATWOOT_BASE_URL
  CHATWOOT_TOKEN
  TUNNEL_TRAFFIC_RETENTION_DAYS
  HIDE_FOOTER
  HIDE_DOCS
  LANDING_PAGE_URL
  REFERRAL_COMMISSION_RATE
  REFERRAL_FIRST_ONLY
  REFERRAL_MODE
  OBSERVER_PERIOD
  EMAIL_PROVIDER
  SMTP_HOST
  SMTP_PORT
  SMTP_SECURE
  SMTP_USER
  SMTP_PASS
  SMTP_FROM
  RESEND_API_KEY
  RESEND_FROM
  MIN_WITHDRAW_AMOUNT
  WITHDRAW_METHODS
  LIMIT_SCOPE
  ENABLE_SUBSCRIPTION
  /// V5-WP20-3（契约 §3.1.4 / O4）：结算 `pending` 行的**接管超时**（分钟，字符串数字）。
  /// 缺省不存在 ⇒ 回落 `DEFAULT_SETTLEMENT_TAKEOVER_MINUTES`（10，与充值订单超时同口径）。
  /// 为什么必须可配而不是常量：超时越小越容易重复执行同一周期（结算据此必须幂等可重放），
  /// 越大则崩溃遗留的 pending 越晚被接管；两者是运维权衡，不该由一次发版决定。
  BILLING_SETTLEMENT_TAKEOVER_MINUTES
  /// V5-WP19-B：延迟档案的保留期（原始样本小时数 / 小时桶天数）。
  ///
  /// 这两个键是**被代码用到但当时不在枚举里**的（`latency-history.ts` 的
  /// `LATENCY_RETENTION_CONFIG_KEYS`）。列是 DB ENUM ⇒ 不在枚举里的键**根本存不进去**：
  /// 读取永远得到 null（静默回落到默认值），运维也永远设不上 —— 一个"可调"的参数实际上是常量。
  /// 补在**枚举末尾**是有意的：MySQL 的 ENUM 是序号存储，中间插值会让存量行错位，
  /// 追加才是可加的。
  LATENCY_RAW_RETENTION_HOURS
  LATENCY_BUCKET_RETENTION_DAYS
}

