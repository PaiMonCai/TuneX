{
  "name": "tunex-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "build": "bun build src/index.ts --target=bun --external external --outdir=dist && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:unit": "bun test src",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.13.0",
    "bcryptjs": "2.4.3",
    "bullmq": "5.56.0",
    "hono": "4.9.2",
    "ioredis": "5.7.0",
    "jose": "6.0.12",
    "zod": "4.0.17",
    "socket.io": "4.7.5",
    "cors": "2.8.5"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "prisma": "6.13.0",
    "typescript": "^7.0.2"
  }
}
