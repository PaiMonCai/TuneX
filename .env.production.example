# ============================================================================
# TuneX OPS-02 —— 生产环境变量模板
#
#   cp .env.production.example .env && chmod 600 .env
#
# 规则（与 scripts/ci/secret-scan.mjs 的扫描目标一致）：
#   · .env 绝不入库（.gitignore 已排除）；只有 *.example 进版本库
#   · 所有密钥必须为每套部署独立生成；任何共享值都视为泄露
#   · 缺失 AUTH_SECRET / DATABASE_URL 时 backend 启动即 fail-fast（backend/src/env.ts）
#
# 生成强随机值的命令：openssl rand -base64 32 | tr '+/' '-_'
# ============================================================================

NODE_ENV=production
TZ=Asia/Shanghai
# 对外唯一站点地址（登录/回调/Agent 安装命令使用；生产必须 https://）。
# standalone 模式下 Caddyfile.prod 同时用它作为 ACME 域名。
SITE_URL=https://tunex.example.com

# 面板对外可达地址：**节点侧 Agent 升级脚本**的身份校验用它（后端读取，见
# backend/src/routes/nodes.ts 的 upgrade-command）。
#   · 用途：`POST /api/nodes/:id/upgrade-command` 渲染出的脚本会在节点容器内请求
#     `<该地址>/api/internal/node/snapshot`，确认新起的 Agent 仍以同一个
#     node_id/agent_id 通过认证；脚本只打印 HTTP 状态码，凭据不出容器。
#   · 必须是**从节点**能访问到的地址（通常就是 SITE_URL；节点走内网入口时填内网地址）。
#     SITE_URL 只管登录/回调/安装命令，不会自动被这条校验复用。
#   · 留空时脚本回落到节点 agent.env 里记录的 TUNEX_PANEL_HTTP_URL（标准安装脚本写入，
#     值等于安装时的 SITE_URL）。两者都取不到、或节点到面板的请求超时、或镜像里既没有
#     curl 也没有 wget 时，脚本会明确打印「身份校验：未校验 —— <原因>」并在结尾再次提醒；
#     **只有面板明确回 HTTP 200 才会打印「身份校验：通过」**，不会给出虚假的安全感。
# 例：
# TUNEX_PUBLIC_PANEL_URL=https://tunex.example.com

# --- 数据存储（compose 内网服务名直连；生产不映射主机端口） -------------------
# MYSQL_ROOT_PASSWORD 也会注入 compose 的 mysql 服务；两边必须一致。
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_DATABASE=tunex
# root 口令与上行保持同步；占位口令必须一起替换。
DATABASE_URL=mysql://root:change-me-strong-root-password@mysql:3306/tunex
REDIS_URL=redis://redis:6379

# --- 会话 / 签名（每套部署独立，>=32 随机字节） ------------------------------
AUTH_SECRET=replace-with-32-plus-random-bytes
JWT_ISSUER=tunex
JWT_TTL_SECONDS=43200
# 生产必须 true：Cookie 只在 HTTPS 下下发（否则登录态在公网裸奔）
COOKIE_SECURE=true

# --- 许可 / 授权签名密钥（每套部署独立，>=32 随机字节） ----------------------
# 用途：license 校验与签名。**已发布的 Panel 镜像把它列为必填**：缺失时
# `db-migrate` 会以退出码 1 结束，`docker compose up -d` 随之整体失败
# （实测报错：LICENSE_SECRET is required and has no default）。
# 本仓库当前源码已不再读取它；为了让本示例对"任何镜像版本"都能启动，请一并生成。
LICENSE_SECRET=replace-with-32-plus-random-bytes


# --- 注册与支付开关 ----------------------------------------------------------
# 邀请制 Beta 期间保持 false：关闭自助注册 fallback，只允许已创建账号登录。
ALLOW_REGISTER_FALLBACK=false
# Business-only capabilities stay disabled unless explicitly licensed.
LICENSE_TYPE=none
LICENSE_EXPIRED_AT=0
# 支付写入口/回调默认关闭（PLAN.md 4.4）；确认链路审查通过前不得置 true。
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# worker 容器单独跑（compose 有独立 worker 服务），backend 内不再重复启动。
DISABLE_WORKER=false

# --- 邮件（TEN-03 邮箱验证 / 密码重置）--------------------------------------
# 未配置时邮件内容只进日志，用户收不到验证码 —— 公网服务必须配 SMTP。
SMTP_HOST=replace-with-smtp-host.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=replace-with-noreply-address
EMAIL_VERIFY_TTL_SECONDS=86400
RESEND_VERIFICATION_INTERVAL=60

# --- 首启管理员种子（SEED_ADMIN_PASSWORD 留空则随机生成） --------------------
SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=false
# 凭据落点：compose 把项目根挂到 /host，种子容器写 <project root>/.admin-credentials
ADMIN_CREDENTIALS_PATH=/host/.admin-credentials

# --- 限流与审计（默认开；压测可临时关限流） ---------------------------------
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true

# --- 告警通知（scripts/ops/alert.sh 用；钉钉/企微/Slack 兼容 JSON） ---------
# ALERT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# 告警去重窗口（秒）：同一 check + 同一级别在窗口内不重复打扰
ALERT_DEDUPE_SECONDS=3600

# --- 面向用户的通知渠道（V5-WP18.3 / 18.4）--------------------------------
# 三者**默认关**：新增的出站通道一律默认关闭（Lead 裁决）—— 其理由是"出问题时第一嫌疑人是
# 配置而不是代码"，默认关 + 显式打开能让排查少走一个数量级。开启前请先确认你要投递的目标。
#
# webhook：目标必须 https，且**解析到的每个地址**都必须是公网（私网/环回/链路本地/多播/ULA/
# CGNAT/保留段一律拒绝，任何一个内网地址即整体拒绝）；不跟随重定向。
TUNEX_NOTIFICATION_WEBHOOK_ENABLED=false
# 仅**非生产**环境生效（生产即使打开也拒绝 http）：本地联调第三方 webhook 时才需要。
TUNEX_NOTIFICATION_WEBHOOK_ALLOW_HTTP=false
# telegram：bot token 以密文存于 `notification_channel.secret_enc`
# （独立 HKDF 域 `tunex-notification-v1`，与联邦/DDNS 的派生密钥互不通用）。
# 收件人只来自 `User.tg_id`；**未绑定即不投递**（不会猜用户）。
TUNEX_NOTIFICATION_TELEGRAM_ENABLED=false

# --- Looking Glass 主动诊断（V5-WP19-D）-------------------------------------
# 默认关闭。打开后，具备 node:read 的用户可从自己 workspace 的节点发起**有界 TCP connect**
# 公网探测；私网/环回/链路本地/多播/保留段均在 Panel 与 Agent 两侧拒绝，并写审计。
LOOKING_GLASS_ENABLED=false

# --- 备份（scripts/ops/backup.sh / rollback.sh 用） -------------------------
# 备份加密口令；cron 环境中回滚前备份必须预设（否则备份交互读取会失败并终止回滚）
# BACKUP_PASSPHRASE=replace-with-backup-passphrase
# 本地保留天数；如需异地请自行配置 rsync/crontab（备份脚本只负责本地落盘）
RETENTION_DAYS=14

# --- 镜像版本（compose 按 commit sha 钉住；回滚只切这一个值） ---------------
# CI 每个发布 push 都推 ghcr.io/paimoncai/tunex:<git-sha> 与 :latest。
# backend / worker / db-migrate / web 共用同一个不可变镜像 digest。
# 生产不要浮动引用 :latest —— rollback.sh --to <target> 需要明确回到某个版本。
TUNEX_IMAGE=ghcr.io/paimoncai/tunex:replace-with-git-sha
# Node 一键安装使用的独立多架构 Agent 镜像。生产建议与 TUNEX_IMAGE 使用同一 git sha。
TUNEX_AGENT_IMAGE=ghcr.io/paimoncai/tunex-agent:replace-with-git-sha
# 面板判定"节点 Agent 落后"的基线（backend/src/env.ts: agentLatestVersion）。
#   · 用途：① 健康合成给出 `agent_version_behind`（backend/src/services/node-health.ts）；
#     ② 用户域「Agent 升级」卡片读它（`GET /api/nodes/:id/upgrade-state` 的
#     `target.expected_version` / `target.version_drift`，backend/src/routes/nodes.ts）。
#     比较由**服务端**用同一个函数（`isVersionOlder`）完成，前端不重算、也不自己编版本口径。
#   · 与"实际上报版本"的关系：节点**实际运行**的版本来自节点上报
#     （`node_state_report.version`，面板侧读作 `reported.version`），**不是**管理端配置的
#     `node.version`（那是管理员手填字段，真机取证常常是 `unknown`）。这个变量只提供
#     "应该是哪个版本"的对照基线。
#   · 留空（模板默认）= 面板**不判落后**：`version_drift` 恒为 `unknown`（既不说落后，也不说
#     已经最新），用户域卡片会如实显示"部署方未声明版本基线"。因此**默认部署下不会出现任何
#     升级建议**——要让面板提示节点升级，必须显式设置这一项。
#   · 格式：必须是**可比较的版本号**（首段为数字，例如 `0.14.0`）。`unknown` / `latest` /
#     空串 / 40 位 git sha 都会解析失败 ⇒ 一律落回 `unknown`。
#     ⚠️ **已知缺口（实测）**：一键安装（`scripts/ops/install.sh --version <git-sha>`）当前把
#     这一项写成 **git sha**，而 Agent 上报的是版本号（`agent/main.go` 的 `version`，例如
#     `0.13.22`）⇒ 两者不可比较，`agent_version_behind` 与用户域的 `version_drift` 会**一直是
#     `unknown`**（既不判落后，也不判最新）。要让面板真的提示升级，请显式把它设为最新 Agent
#     镜像对应的版本号。
# 例：
# TUNEX_AGENT_LATEST_VERSION=0.14.0
# 兜底已知良好版本（rollback.sh 的 ROLLBACK_KNOWN_GOOD_IMAGE 读取它）
# ROLLBACK_KNOWN_GOOD_IMAGE=ghcr.io/paimoncai/tunex:replace-with-git-sha

# --- 宿主机反代端口（全部仅绑定 127.0.0.1）---------------------------------
# 默认不启动 Caddy：宿主机 Nginx/宝塔/1Panel 分别路由 Web / API / WebSocket。
TUNEX_API_PORT=13001
TUNEX_WS_PORT=13002
TUNEX_WEB_PORT=13003

# --- 可选内部 Caddy -----------------------------------------------------------
# docker compose -f docker-compose.prod.yaml --profile caddy up -d
# 启用后可把宿主机反代简化为一个统一入口。
TUNEX_HTTP_PORT=13000

# --- standalone Caddy（仅无宿主机反代时使用）-------------------------------
# docker-compose.standalone.yaml 会让 Caddy 直接占用 80/443 并自动 ACME。
# 该 overlay 会把本 .env 注入 Caddy，因此 SITE_URL / ACME_EMAIL 可被 Caddyfile.prod 读取。
ACME_EMAIL=ops@example.com
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# --- 可选：容器资源上限（默认值即 4C8G 主机的安全起步值，可按需调大） --------
MYSQL_CPU_LIMIT=2
MYSQL_MEM_LIMIT=2048M
REDIS_CPU_LIMIT=1
REDIS_MEM_LIMIT=512M
BACKEND_CPU_LIMIT=2
BACKEND_MEM_LIMIT=1024M
WORKER_CPU_LIMIT=1
WORKER_MEM_LIMIT=768M
WEB_CPU_LIMIT=1
WEB_MEM_LIMIT=768M
CADDY_CPU_LIMIT=1
CADDY_MEM_LIMIT=256M
