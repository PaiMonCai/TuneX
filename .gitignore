# Local configuration and credentials
.env
.env.*
!.env.example
!.env.*.example
.admin-credentials
*.pem
*.key

# Dependency/build artifacts
# node_modules is a symlink to /opt/TuneX/backend/node_modules in this workspace;
# `**/node_modules/` only matches real directories, so the symlink needs its own rule.
node_modules
**/node_modules/
**/.next/
**/dist/
**/build/
**/coverage/
**/.turbo/
**/*.tsbuildinfo

# Local tools and logs
*.log
.DS_Store
Thumbs.db
agent/tunex-agent

# WP14 v3 E2E Harness 运行期产物（密钥/口令/状态/证据，切勿提交）
# 注意：_bootstrap.py 是**交付物**（fixture→控制面 HTTP API 的桥，setup.sh 调用），
# 有意不在此列；勿与 net01-e2e 的忽略项混抄。
scripts/v3-e2e/.env.wp14
scripts/v3-e2e/.passwords.env
scripts/v3-e2e/state.json
scripts/v3-e2e/agent.Dockerfile.e2e
scripts/v3-e2e/evidence/
scripts/v3-e2e/__pycache__/

# backend v3 E2E harness 运行期产物
backend/tests/v3-e2e/.artifacts/
backend/tests/v3-e2e/__pycache__/

# V5-WP3 性能基线运行期产物
# .bin/ 是本地构建的 Agent；results/ 是每次跑出来的产物。
# baseline/ **不**在此列：它是提交进仓库的"锚点"，用于相对趋势对比。
scripts/perf/.bin/
scripts/perf/results/
scripts/perf/__pycache__/
