# Dependency/build artifacts
# node_modules is a symlink to /opt/TuneX/backend/node_modules in this workspace;
# `**/node_modules/` only matches real directories, so the symlink needs its own rule.
node_modules
**/node_modules/
**/.next/
**/dist/
**/build/
**/coverage/
**/.turbo/
**/*.tsbuildinfo

# Local tools and logs
*.log
.DS_Store
Thumbs.db
agent/tunex-agent

