# TuneX environment template. Copy to .env and fill in real values.
# Never commit the filled-in .env file.

NODE_ENV=production
TZ=Asia/Shanghai
SITE_URL=https://tunex.example.com
PORT=3000

# --- Data stores (keep off the public internet) ---
MYSQL_ROOT_PASSWORD=change-me-strong
MYSQL_DATABASE=tunex
DATABASE_URL=mysql://root:change-me-strong@mysql:3306/tunex
REDIS_URL=redis://redis:6379

# --- Session / API signing (>=32 random bytes each) ---
AUTH_SECRET=replace-with-32-plus-random-bytes
JWT_ISSUER=tunex
JWT_TTL_SECONDS=43200
COOKIE_SECURE=true


# --- First-run admin seed (password optional; random if omitted) ---
SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# Demo rows are opt-in even in the generic template; production must never
# acquire sample plans/nodes merely because this file was copied verbatim.
SEED_DEMO_DATA=false

# Payment gateways are opt-in and unrelated to roles/capabilities.
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Experimental core Forward bulk delete; enable only after A00 real multi-Agent acceptance.
FORWARD_BATCH_DELETE_ENABLED=false
ALLOW_REGISTER_FALLBACK=false
DISABLE_WORKER=false

# --- Rate limiting + audit logging ---
# Both default to enabled; set to "false" to disable (e.g. load testing).
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
